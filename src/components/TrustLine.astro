---
// The hero states the digest scope in its own check line, so it hides the opening item here (Marketing 11/10).
const { showDigestScope = true } = Astro.props;
---
<p class="trust">{showDigestScope && <><b>Digest covers only senders you pick.</b><span class="dot"></span></>}Works with Gmail.<span class="dot"></span>Read-only.<span class="dot"></span>Your information is never sold.<span class="dot"></span>No ads.<span class="dot"></span>No hidden fees.</p>

<style>
  .trust{margin:26px 0 0 50%;transform:translateX(-50%);width:max-content;max-width:calc(100vw - 32px);font-size:13px;color:var(--muted);letter-spacing:.1px;text-align:center}
  .trust b{color:var(--ink);font-weight:500}
  .dot{display:inline-block;width:4px;height:4px;border-radius:50%;background:#cfd6e6;margin:0 9px;vertical-align:middle}
</style>
