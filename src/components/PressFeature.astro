---
import { PRESS_FEATURE } from "../data/press";
import { imageSize } from "../data/image-sizes";
---
<aside class="press" aria-label={PRESS_FEATURE.eyebrow}>
  <a class="press-preview" href={PRESS_FEATURE.url} target="_blank" rel="noopener" aria-label={PRESS_FEATURE.linkLabel}>
    <span class="press-bar" aria-hidden="true"><span class="press-dots"><i></i><i></i><i></i></span><span class="press-domain">{PRESS_FEATURE.previewDomain}</span></span>
    <img src={PRESS_FEATURE.previewImage} {...imageSize(PRESS_FEATURE.previewImage)} alt={PRESS_FEATURE.previewImageAlt} loading="lazy" />
  </a>
  <div class="press-copy">
    <p class="press-eyebrow">{PRESS_FEATURE.eyebrow}</p>
    <blockquote class="press-quote"><p>“{PRESS_FEATURE.quote}”</p></blockquote>
    <p class="press-attribution">{PRESS_FEATURE.attribution}</p>
    <p class="press-byline">{PRESS_FEATURE.byline}</p>
    <a class="press-link" href={PRESS_FEATURE.url} target="_blank" rel="noopener">{PRESS_FEATURE.linkLabel} <span aria-hidden="true">↗</span></a>
  </div>
</aside>

<style>
  .press{max-width:960px;margin:32px auto 40px;padding:18px;display:grid;grid-template-columns:340px 1fr;gap:32px;align-items:center;border-radius:26px;background:linear-gradient(145deg,rgba(255,255,255,.8),rgba(255,255,255,.5));border:1px solid rgba(255,255,255,.9);box-shadow:inset 0 1px 0 rgba(255,255,255,.95),0 14px 34px rgba(27,34,54,.08)}
  .press-copy{text-align:left;padding-right:12px}
  .press-eyebrow{margin:0;font-size:13px;font-weight:600;letter-spacing:1.2px;text-transform:uppercase;color:var(--purple)}
  .press-quote{margin:10px 0 0;font-size:clamp(26px,3.2vw,36px);line-height:1.15;font-weight:500;letter-spacing:-.6px;color:var(--navy)}
  .press-quote p{margin:0}
  .press-attribution{margin:10px 0 0;font-size:15px;font-weight:500;color:var(--ink)}
  .press-byline{margin:2px 0 0;font-size:14px;color:var(--muted)}
  .press-link{display:inline-block;margin-top:16px;font-size:16px;font-weight:600;color:var(--purple);text-decoration:none}
  .press-link:hover{text-decoration:underline;text-underline-offset:3px}
  .press-preview{display:block;text-decoration:none;border-radius:16px;overflow:hidden;background:#fff;border:1px solid var(--line);box-shadow:0 18px 40px rgba(27,34,54,.14);transition:transform .2s ease}
  .press-preview:hover{transform:translateY(-2px)}
  .press-bar{display:flex;align-items:center;gap:12px;padding:9px 12px;background:#f3f4f8;border-bottom:1px solid var(--line)}
  .press-dots{display:flex;gap:5px}
  .press-dots i{width:9px;height:9px;border-radius:50%;background:#d5d8e3}
  .press-domain{flex:1;padding:4px 10px;border-radius:999px;background:#fff;font-size:12.5px;color:var(--muted);text-align:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .press-preview img{display:block;width:100%;height:auto;aspect-ratio:16/10;object-fit:cover;object-position:center 30%}
  @media (max-width:760px){
    .press{grid-template-columns:1fr;gap:22px;padding:22px;margin:28px 16px 36px}
    .press-copy{text-align:center;padding-right:0}
  }
</style>
