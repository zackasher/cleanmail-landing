---
import { PRESS_FEATURE } from "../data/press";
---
<aside class="press" aria-label={PRESS_FEATURE.eyebrow}>
  <p class="press-eyebrow">{PRESS_FEATURE.eyebrow}</p>
  <blockquote class="press-quote"><p>“{PRESS_FEATURE.quote}”</p></blockquote>
  <p class="press-attribution">{PRESS_FEATURE.attribution}</p>
  <a class="press-link" href={PRESS_FEATURE.url} target="_blank" rel="noopener">{PRESS_FEATURE.linkLabel} <span aria-hidden="true">↗</span></a>
</aside>

<style>
  .press{max-width:560px;margin:28px auto 40px;padding:22px 24px;text-align:center;border-radius:22px;background:linear-gradient(145deg,rgba(255,255,255,.75),rgba(255,255,255,.45));border:1px solid rgba(255,255,255,.9);box-shadow:inset 0 1px 0 rgba(255,255,255,.95),0 10px 28px rgba(27,34,54,.07)}
  .press-eyebrow{margin:0;font-size:13px;font-weight:600;letter-spacing:1.2px;text-transform:uppercase;color:var(--purple)}
  .press-quote{margin:10px 0 0;font-size:clamp(22px,3vw,28px);font-weight:500;letter-spacing:-.4px;color:var(--navy)}
  .press-quote p{margin:0}
  .press-attribution{margin:8px 0 0;font-size:14px;color:var(--muted)}
  .press-link{display:inline-block;margin-top:12px;font-size:15px;font-weight:600;color:var(--purple);text-decoration:none}
  .press-link:hover{text-decoration:underline;text-underline-offset:3px}
</style>
