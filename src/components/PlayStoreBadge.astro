---
import { PLAY_STORE_URL, PLAY_BADGE_IMAGE_PATH, PLAY_BADGE_IMAGE_WIDTH, PLAY_BADGE_IMAGE_HEIGHT, PLAY_BADGE_ALT } from "../config";
---
<a class="play-badge" href={PLAY_STORE_URL}>
  <img src={PLAY_BADGE_IMAGE_PATH} alt={PLAY_BADGE_ALT} width={PLAY_BADGE_IMAGE_WIDTH} height={PLAY_BADGE_IMAGE_HEIGHT} />
</a>
<style>
  .play-badge{display:inline-flex;align-items:center;transition:transform .15s}
  .play-badge:hover{transform:translateY(-1px)}
  /* Same height as the App Store badge (54px) so the two read as a pair. */
  .play-badge img{height:54px;width:auto;display:block}
</style>
