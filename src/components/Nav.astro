---
import { imageSize } from "../data/image-sizes";
import { WEB_APP_URL, WEB_APP_SIGN_IN_LABEL } from "../config";
import { SWITCHING_PAGES } from "../data/switching-from";
import { FEATURE_PAGES, FEATURE_PAGES_PATH_PREFIX } from "../data/feature-pages";
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isHome = path === "/";
const SWITCHING_PATH_PREFIX = "/switching-from/";
type MenuItem = { href: string; label: string; fullLabel: string };
type NavMenu = { id: string; buttonLabel: string; allLabel: string; groupLabel: string; activePrefix: string; items: MenuItem[] };
// A top-nav chip whose href is a key here opens a glass dropdown. New pages join their menu's items.
const menus: Record<string, NavMenu> = {
  "/features": {
    id: "features-menu",
    buttonLabel: "Show feature pages",
    allLabel: "All features",
    groupLabel: "Add dates from",
    activePrefix: FEATURE_PAGES_PATH_PREFIX,
    items: FEATURE_PAGES.map((page) => ({ href: `${FEATURE_PAGES_PATH_PREFIX}${page.slug}`, label: page.menuLabel, fullLabel: page.title })),
  },
  "/compare": {
    id: "compare-menu",
    buttonLabel: "Show comparison pages",
    allLabel: "All comparisons",
    groupLabel: "Switching from",
    activePrefix: SWITCHING_PATH_PREFIX,
    items: SWITCHING_PAGES.map((page) => ({ href: `${SWITCHING_PATH_PREFIX}${page.slug}`, label: page.name, fullLabel: `Switching from ${page.name}` })),
  },
};
const isActive = (href: string) => path === href || (menus[href] !== undefined && path.startsWith(menus[href].activePrefix));
const links = [
  { href: "/how-it-works", label: "How It Works" },
  { href: "/features", label: "Features" },
  { href: "/compare", label: "Compare" },
  { href: "/pricing", label: "Pricing" },
  { href: "/privacy", label: "Privacy" },
  { href: "/faq", label: "FAQ" },
  { href: "/blog", label: "Blog" },
];
---
<nav transition:persist class:list={[{ compact: !isHome }]}>
  <a class="wordmark" href="/" aria-label="Cleanmail home">
    <img src="/icon.webp" {...imageSize("/icon.webp")} alt="Cleanmail" class="mark" />
  </a>
  <div class="navright">
    <div class="seg">
      {links.map((l) => menus[l.href] ? (
        <div class="drop">
          <a href={l.href} class={`chip drop-chip${isActive(l.href) ? " active" : ""}`} data-active-prefix={menus[l.href].activePrefix}>{l.label}</a>
          <button class="drop-btn" type="button" aria-expanded="false" aria-controls={menus[l.href].id} aria-label={menus[l.href].buttonLabel}>
            <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </button>
          <div class="drop-menu" id={menus[l.href].id}>
            <div class="drop-panel">
              <a class="drop-all" href={l.href}>{menus[l.href].allLabel}<span aria-hidden="true">→</span></a>
              <p class="drop-eyebrow">{menus[l.href].groupLabel}</p>
              {menus[l.href].items.map((item) => (
                <a class="drop-item" href={item.href} aria-label={item.fullLabel}>
                  <span class="drop-dot" aria-hidden="true"></span>{item.label}
                </a>
              ))}
            </div>
          </div>
        </div>
      ) : (
        <a href={l.href} class={`chip${path === l.href ? " active" : ""}`}>{l.label}</a>
      ))}
    </div>
    <a class="signin" href={WEB_APP_URL}>{WEB_APP_SIGN_IN_LABEL}</a>
    <button class="burger" id="menu-btn" aria-label="Open menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
  <div class="mobile-menu" id="mobile-menu">
    {links.map((l) => menus[l.href] ? (
      <>
        <a href={l.href}>{l.label}</a>
        <div class="mobile-sub">
          {menus[l.href].items.map((item) => <a href={item.href}>{item.fullLabel}</a>)}
        </div>
      </>
    ) : (
      <a href={l.href}>{l.label}</a>
    ))}
    <a href={WEB_APP_URL}>{WEB_APP_SIGN_IN_LABEL}</a>
  </div>
</nav>

<style>
  /* The glass lives on ::before, not on nav itself: a backdrop-filter on nav would stop the dropdown panels' own blur from reaching the page. */
  nav{position:sticky;top:14px;z-index:50;width:calc(100% - 40px);max-width:2200px;margin:14px auto 0;display:flex;align-items:center;justify-content:space-between;padding:11px 26px;border:1px solid rgba(255,255,255,.55);border-radius:22px;box-shadow:0 12px 34px rgba(27,34,54,.10), inset 0 1px 0 rgba(255,255,255,.7)}
  nav::before{content:"";position:absolute;inset:0;z-index:-1;border-radius:inherit;background:linear-gradient(135deg, rgba(255,255,255,.34), rgba(255,255,255,.20));backdrop-filter:blur(8px) saturate(1.2)}
  nav{transition:width .55s cubic-bezier(.2,.7,.2,1)}
  nav.compact{width:66%}
  .wordmark{position:relative;z-index:2;display:inline-flex;align-items:center;text-decoration:none}
  .wordmark .mark{height:40px;width:auto;display:block;filter:drop-shadow(0 1px 3px rgba(27,34,54,.16))}
  .navright{display:flex;align-items:center;gap:18px}
  .seg{display:flex;align-items:center;gap:8px}
  .chip{font-size:14px;font-weight:400;color:var(--ink);background:rgba(255,255,255,.82);border:1px solid rgba(74,111,227,.16);padding:8px 15px;border-radius:999px;text-decoration:none;transition:all .15s;white-space:nowrap}
  .chip:hover{border-color:rgba(74,111,227,.5);color:var(--purple);background:#fff}
  .chip.active{background:var(--purple);color:#fff;border-color:var(--purple);box-shadow:0 5px 14px rgba(74,111,227,.28)}
  .signin{font-size:14px;font-weight:500;color:var(--purple);background:#fff;border:1.5px solid var(--purple);padding:7px 16px;border-radius:999px;text-decoration:none;transition:all .15s;white-space:nowrap}
  .signin:hover{background:var(--purple);color:#fff;box-shadow:0 5px 14px rgba(74,111,227,.28)}
  .burger{display:none;flex-direction:column;align-items:center;justify-content:center;gap:5px;width:42px;height:42px;padding:0;background:rgba(255,255,255,.82);border:1px solid rgba(74,111,227,.16);border-radius:12px;cursor:pointer}
  .burger span{display:block;width:24px;height:2.5px;border-radius:2px}
  .burger span:nth-child(1){background:#4A6FE3}
  .burger span:nth-child(2){background:#2D4BAD}
  .burger span:nth-child(3){background:#4A6FE3}
  .mobile-menu{display:none;position:absolute;top:100%;right:14px;margin-top:10px;background:#fff;border:1px solid var(--line);border-radius:14px;box-shadow:0 14px 40px rgba(27,34,54,.12);padding:8px;min-width:200px;z-index:60}
  .mobile-menu.open{display:block}
  .mobile-menu a{display:block;padding:10px 14px;font-size:15px;color:var(--ink);text-decoration:none;border-radius:9px}
  .mobile-menu a:hover{background:var(--card);color:var(--purple)}
  .drop{position:relative;display:flex;align-items:center}
  .drop-chip{padding-right:32px}
  .drop-btn{position:absolute;right:6px;top:50%;transform:translateY(-50%);width:24px;height:24px;display:flex;align-items:center;justify-content:center;padding:0;border:0;border-radius:50%;background:transparent;color:inherit;cursor:pointer}
  .drop-btn svg{width:12px;height:12px;transition:transform .15s}
  .drop-chip.active + .drop-btn{color:#fff}
  .drop-menu{display:none;position:absolute;top:100%;left:0;padding-top:8px;min-width:230px;z-index:60}
  .drop-panel{position:relative;overflow:hidden;background:linear-gradient(150deg, rgba(255,255,255,.62), rgba(240,244,255,.48));backdrop-filter:blur(18px) saturate(1.6);border:1px solid rgba(255,255,255,.75);border-radius:20px;box-shadow:0 18px 44px rgba(27,34,54,.16), inset 0 1px 0 rgba(255,255,255,.9);padding:10px}
  .drop-panel::before{content:"";position:absolute;inset:0 0 auto 0;height:45%;background:linear-gradient(180deg, rgba(255,255,255,.55), rgba(255,255,255,0));pointer-events:none}
  .drop-panel a{position:relative;display:flex;align-items:center;gap:10px;padding:10px 14px;font-size:14px;color:var(--ink);text-decoration:none;border-radius:999px;white-space:nowrap;transition:background .15s,color .15s,transform .15s}
  .drop-panel a:hover,.drop-panel a:focus-visible{background:rgba(74,111,227,.10);color:var(--purple);transform:translateX(2px)}
  .drop-all{justify-content:space-between;font-weight:500;color:var(--navy)}
  .drop-all span{color:var(--purple);transition:transform .15s}
  .drop-all:hover span{transform:translateX(3px)}
  .drop-eyebrow{position:relative;margin:8px 14px 4px;padding-top:10px;border-top:1px solid rgba(74,111,227,.14);font-size:11px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
  .drop-dot{width:8px;height:8px;border-radius:50%;background:var(--purple);box-shadow:0 0 0 3px rgba(74,111,227,.14)}
  .drop-menu .drop-panel{animation:dropIn .16s ease-out}
  @keyframes dropIn{from{opacity:0;transform:translateY(-4px) scale(.98)}to{opacity:1;transform:none}}
  @media (prefers-reduced-motion:reduce){.drop-menu .drop-panel{animation:none}.drop-panel a{transition:none}}
  .drop:hover .drop-menu,.drop.open .drop-menu{display:block}
  .drop:hover .drop-btn svg,.drop.open .drop-btn svg{transform:rotate(180deg)}
  .mobile-sub{margin:-4px 0 4px 14px;border-left:2px solid var(--line);padding-left:4px}
  .mobile-sub a{font-size:14px;padding:8px 12px;color:var(--muted)}
  @media(max-width:940px){.seg{display:none}.signin{display:none}.burger{display:flex}}
</style>

<script>
  function initDropMenus() {
    document.querySelectorAll<HTMLElement>(".drop").forEach(initDropMenu);
  }
  function initDropMenu(drop: HTMLElement) {
    const button = drop.querySelector<HTMLButtonElement>(".drop-btn");
    if (!button || button.dataset.bound) return;
    button.dataset.bound = "1";
    const setOpen = (open: boolean) => {
      drop.classList.toggle("open", open);
      button.setAttribute("aria-expanded", String(open));
    };
    button.addEventListener("click", (event) => {
      event.stopPropagation();
      setOpen(!drop.classList.contains("open"));
    });
    drop.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      setOpen(false);
      button.focus();
    });
    drop.addEventListener("focusout", (event) => {
      if (!drop.contains(event.relatedTarget as Node | null)) setOpen(false);
    });
    document.addEventListener("click", () => setOpen(false));
  }
  function syncNav() {
    const nav = document.querySelector("nav");
    if (!nav) return;
    const p = location.pathname.replace(/\/$/, "") || "/";
    nav.classList.toggle("compact", p !== "/");
    nav.querySelectorAll(".chip").forEach((c) => {
      const href = c.getAttribute("href");
      const prefix = c.getAttribute("data-active-prefix");
      const underMenu = prefix !== null && p.startsWith(prefix);
      c.classList.toggle("active", href === p || underMenu);
    });
  }
  function initBurger() {
    const btn = document.getElementById("menu-btn");
    const menu = document.getElementById("mobile-menu");
    if (!btn || !menu || btn.dataset.bound) return;
    btn.dataset.bound = "1";
    btn.addEventListener("click", (e) => {
      e.stopPropagation();
      const open = menu.classList.toggle("open");
      btn.setAttribute("aria-expanded", String(open));
    });
    document.addEventListener("click", () => menu.classList.remove("open"));
  }
  initBurger();
  initDropMenus();
  syncNav();
  document.addEventListener("astro:page-load", () => {
    initBurger();
    initDropMenus();
    syncNav();
  });
</script>
