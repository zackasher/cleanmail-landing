---
import { publishedPosts } from "../data-blog";
import { BLOG_READS_HEADING } from "../config";

interface Props {
  slugs: string[];
}

const { slugs } = Astro.props;
const postsBySlug = new Map(publishedPosts().map((post) => [post.slug, post]));
const posts = slugs.map((slug) => postsBySlug.get(slug)).filter((post) => post !== undefined);
---
{posts.length > 0 && (
  <aside class="blog-reads">
    <h2>{BLOG_READS_HEADING}</h2>
    <div class="blog-reads-list">
      {posts.map((post) => (
        <a class="blog-read" href={`/blog/${post.slug}`}>
          <strong>{post.frontmatter.title}</strong>
          <span>{post.frontmatter.description}</span>
        </a>
      ))}
    </div>
  </aside>
)}

<style>
  .blog-reads{max-width:720px;margin:48px auto 0;padding:0 16px;text-align:center}
  .blog-reads h2{font-size:22px;color:var(--navy);margin:0 0 14px;text-align:center}
  .blog-reads-list{display:grid;gap:12px}
  .blog-read{display:block;padding:16px 18px;border:1.5px solid var(--line);border-radius:14px;background:#fff;text-decoration:none;transition:border-color .15s}
  .blog-read:hover{border-color:rgba(74,111,227,.45)}
  .blog-read strong{display:block;font-size:16px;color:var(--purple);margin-bottom:4px}
  .blog-read span{display:block;font-size:14px;line-height:1.45;color:var(--muted)}
</style>
