---
import AppLink from "./AppLink.astro";
import { YOUTUBE_VIDEO_URL, COOKIE_SETTINGS_LABEL } from "../config";
---
<AppLink />
<footer>
  <div class="footer-links">
    <a href="/privacy">Privacy Policy</a>
    <a href="/terms">Terms of Service</a>
    <a href="/support">Support</a>
    <a href="/google-calendar-sync">Google Calendar Sync</a>
    <a href="/family-calendar-app">Family Calendar App</a>
    <a href="/compare">Compare</a>
    <a href="/share">Share, get 2 weeks free</a>
    <a href="/blog">Blog</a>
    <a href="/maple-alternative">Leaving Maple?</a>
    <a href={YOUTUBE_VIDEO_URL} rel="noopener" target="_blank">Watch on YouTube</a>
    <button type="button" class="cookie-settings-link" data-cookie-settings>{COOKIE_SETTINGS_LABEL}</button>
  </div>
  <p class="footer-copy">© 2026 Calibrate LLC. All rights reserved.</p>
</footer>

<style>
  footer{text-align:center;padding:26px 26px 44px;background:transparent}
  .footer-links{display:flex;flex-wrap:wrap;justify-content:center;gap:10px 24px;margin-bottom:10px}
  .footer-links a{font-size:12px;color:var(--muted);text-decoration:none;transition:color .15s}
  .footer-links a:hover{color:var(--purple)}
  .cookie-settings-link{font:inherit;font-size:12px;color:var(--muted);background:none;border:0;padding:0;cursor:pointer}
  .cookie-settings-link:hover{color:var(--purple)}
  .footer-copy{font-size:12px;color:#9aa1b4}
</style>
