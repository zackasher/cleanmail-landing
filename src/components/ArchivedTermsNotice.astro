---
import { ARCHIVED_TERMS_NOTICE_BEFORE, ARCHIVED_TERMS_NOTICE_AFTER, CURRENT_TERMS_PATH } from "../config";

interface Props { effectiveRange: string }
const { effectiveRange } = Astro.props;
---
<p class="terms-version-notice">{ARCHIVED_TERMS_NOTICE_BEFORE} {effectiveRange}. {ARCHIVED_TERMS_NOTICE_AFTER} <a href={CURRENT_TERMS_PATH}>{CURRENT_TERMS_PATH}</a>.</p>

<style>
  .terms-version-notice{padding:12px 16px;border:1px solid var(--line);border-radius:12px;background:#f7f9ff}
</style>
