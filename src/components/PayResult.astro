---
export interface Props {
  variant?: "success" | "neutral";
  title: string;
  message: string;
  href: string;
  buttonLabel: string;
}
const { variant = "success", title, message, href, buttonLabel } = Astro.props;
---
<section class="pay">
  <div class="pay-card">
    <div class:list={["pay-ic", variant]}>
      {variant === "success" ? (
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7" /></svg>
      ) : (
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 14L4.5 9.5 9 5" /><path d="M4.5 9.5H14a5.5 5.5 0 0 1 0 11h-3" /></svg>
      )}
    </div>
    <h1 class="pay-title">{title}</h1>
    <p class="pay-msg">{message}</p>
    <a class="pay-btn" href={href}>{buttonLabel}</a>
    <p class="pay-fallback">If nothing happens, just reopen Cleanmail on your phone.</p>
  </div>
</section>
<style>
  .pay{max-width:560px;margin:0 auto;padding:72px 24px 120px;text-align:center}
  .pay-card{background:#fff;border:1px solid var(--line);border-radius:24px;padding:44px 32px;box-shadow:0 14px 40px rgba(27,34,54,.08)}
  .pay-ic{width:64px;height:64px;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 22px}
  .pay-ic svg{width:30px;height:30px}
  .pay-ic.success{background:rgba(93,196,184,.16);color:var(--teal)}
  .pay-ic.neutral{background:rgba(74,111,227,.12);color:var(--purple)}
  .pay-title{font-size:clamp(24px,4vw,32px);font-weight:500;letter-spacing:-.6px;color:var(--navy);margin:0 0 14px}
  .pay-msg{font-size:16.5px;line-height:1.6;color:var(--ink);margin:0 auto 30px;max-width:400px}
  .pay-btn{display:inline-block;background:var(--purple);color:#fff;text-decoration:none;font-size:16px;font-weight:600;padding:15px 34px;border-radius:14px;box-shadow:0 6px 18px rgba(74,111,227,.35);transition:filter .15s ease}
  .pay-btn:hover{filter:brightness(0.94)}
  .pay-fallback{font-size:14px;line-height:1.5;color:var(--muted);margin:18px auto 0;max-width:340px}
</style>
