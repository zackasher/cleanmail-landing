---
---
<div class="sd" role="img" aria-label="Cleanmail and Google Calendar stay in sync both ways.">
  <div class="sd-node">
    <img src="/icon.png" alt="" class="sd-app" />
    <span>Cleanmail</span>
  </div>
  <svg class="sd-spin" viewBox="0 0 48 48" fill="none" stroke-width="3.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <g stroke="var(--purple)"><path d="M9.2 18A16 16 0 0 1 38.8 18" /><path d="M33.6 16.4L38.8 18L40.2 12.6" /></g>
    <g stroke="var(--orange)"><path d="M38.8 30A16 16 0 0 1 9.2 30" /><path d="M14.4 31.6L9.2 30L7.8 35.4" /></g>
  </svg>
  <div class="sd-node">
    <div class="sd-cal" aria-hidden="true">
      <svg viewBox="0 0 48 48"><rect x="5" y="9" width="38" height="34" rx="7" fill="#fff" stroke="currentColor" stroke-width="3" /><path d="M5 18h38" stroke="currentColor" stroke-width="3" /><path d="M15 5v8M33 5v8" stroke="currentColor" stroke-width="3" stroke-linecap="round" /><text x="24" y="36" text-anchor="middle" font-size="15" font-weight="700" fill="currentColor" font-family="Helvetica Neue,Arial,sans-serif">31</text></svg>
    </div>
    <span>Google Calendar</span>
  </div>
</div>
<style>
  .sd{display:flex;align-items:center;justify-content:center;gap:26px;max-width:400px;margin:0 auto 26px;background:#fff;border:1px solid var(--line);border-radius:22px;padding:20px 22px;box-shadow:0 12px 32px rgba(27,34,54,.07)}
  .sd-node{display:flex;flex-direction:column;align-items:center;gap:7px;font-size:13px;font-weight:600;color:var(--navy);width:96px;text-align:center}
  .sd-app,.sd-cal{width:52px;height:52px}
  .sd-app{border-radius:14px;box-shadow:0 6px 16px rgba(74,111,227,.25)}
  .sd-cal{color:var(--purple)}
  .sd-cal svg{width:100%;height:100%}
  .sd-spin{width:58px;height:58px;flex-shrink:0;animation:sd-rotate 3.2s linear infinite}
  @keyframes sd-rotate{to{transform:rotate(360deg)}}
  @media (prefers-reduced-motion:reduce){.sd-spin{animation:none}}
</style>
