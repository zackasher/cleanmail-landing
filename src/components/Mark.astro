---
export interface Props { kind: "yes" | "but" | "paid" | "partial" | "no" }
const { kind } = Astro.props;
const LABELS = { yes: "Yes", but: "Yes, with a catch", paid: "Yes, on a paid plan", partial: "Partly", no: "No" };
const isCheck = kind === "yes" || kind === "but";
---
<svg class={`mark ${kind}`} viewBox="0 0 20 20" aria-label={LABELS[kind]}>
  <circle cx="10" cy="10" r="10" />
  {isCheck && <path d="M5.6 10.3l2.9 2.9 5.9-6.2" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />}
  {kind === "paid" && <text x="10" y="14.4" text-anchor="middle" font-size="12.5" font-weight="700" fill="#fff" font-family="Helvetica Neue,Arial,sans-serif">$</text>}
  {kind === "partial" && <path d="M6 10h8" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" />}
  {kind === "no" && <path d="M6.6 6.6l6.8 6.8M13.4 6.6l-6.8 6.8" fill="none" stroke="#fff" stroke-width="2.1" stroke-linecap="round" />}
</svg>
<style>
  .mark{width:20px;height:20px;flex-shrink:0;vertical-align:-4px}
  .mark.yes circle{fill:var(--teal)}
  .mark.but circle,.mark.paid circle{fill:var(--purple)}
  .mark.partial circle{fill:var(--orange)}
  .mark.no circle{fill:#c7cddb}
</style>
