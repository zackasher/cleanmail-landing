---
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { ClientRouter } from "astro:transitions";
import { CLARITY_PROJECT_ID, APP_STORE_URL, APP_STORE_NAME, SOCIAL_PROFILE_URLS, GOOGLE_TAG_ID, TRACKING_BLOCKED_COUNTRY_CODES, TRACKING_BLOCKED_TIME_ZONE_PREFIXES, VISITOR_COUNTRY_LOOKUP_PATH, COOKIE_CONSENT_STORAGE_KEY, COOKIE_CONSENT_ACCEPTED, COOKIE_CONSENT_REJECTED, COOKIE_CONSENT_MESSAGE, COOKIE_CONSENT_REGION_OFF_MESSAGE } from "../config";
export interface Props {
  title: string;
  description?: string;
  image?: string;
  faqSchema?: unknown;
  noindex?: boolean;
  noTracking?: boolean;
}
const {
  title,
  description = "Cleanmail turns school, camp, and sports email into one digest sorted by kid, with every date on a family calendar that syncs with Google.",
  image = "/og.png",
  faqSchema,
  noindex = false,
  noTracking = false,
} = Astro.props;

const canonicalPath = Astro.url.pathname
  .replace(/index\.html$/, "")
  .replace(/\.html$/, "")
  .replace(/(.+)\/$/, "$1");
const canonicalURL = new URL(canonicalPath || "/", "https://cleanmailapp.com").href;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="google-site-verification" content="j0driezVtY4Wr0F1EeHI5-nBMDQfm_KR4BI9JMa1Ggo" />
  <meta name="facebook-domain-verification" content="9sqy4uylfm7ujcai4ailmlpdx9iopm" />

  {!noTracking && (
  <script is:inline define:vars={{ clarityProjectId: CLARITY_PROJECT_ID, googleTagId: GOOGLE_TAG_ID, blockedCountryCodes: TRACKING_BLOCKED_COUNTRY_CODES, blockedTimeZonePrefixes: TRACKING_BLOCKED_TIME_ZONE_PREFIXES, countryLookupPath: VISITOR_COUNTRY_LOOKUP_PATH, consentStorageKey: COOKIE_CONSENT_STORAGE_KEY, consentAccepted: COOKIE_CONSENT_ACCEPTED, consentRejected: COOKIE_CONSENT_REJECTED, consentRegionOffMessage: COOKIE_CONSENT_REGION_OFF_MESSAGE }}>
    // Ad and analytics tags load only for visitors outside the EEA, UK and Switzerland who tapped Accept.
    // Any doubt (European time zone, lookup failure, Global Privacy Control, no answer yet) means no tags:
    // a missed page view is cheaper than a tag that fired without consent.
    (function () {
      var trackingAllowedHere = false;
      var tagsLoaded = false;

      function readConsent() {
        try { return localStorage.getItem(consentStorageKey) || ""; } catch (error) { return ""; }
      }
      function saveConsent(choice) {
        try { localStorage.setItem(consentStorageKey, choice); } catch (error) {}
      }
      function banner() { return document.getElementById("cookie-banner"); }
      function showBanner(asRegionNotice) {
        var element = banner();
        if (!element) return;
        element.classList.toggle("region-off", asRegionNotice);
        if (asRegionNotice) element.querySelector("[data-cookie-message]").textContent = consentRegionOffMessage;
        element.hidden = false;
      }
      function hideBanner() {
        var element = banner();
        if (element) element.hidden = true;
      }
      function startTagsIfAccepted() {
        if (!trackingAllowedHere) return;
        if (readConsent() !== consentAccepted) return;
        if (tagsLoaded) return;
        tagsLoaded = true;
        loadTrackingTags();
      }

      document.addEventListener("click", function (event) {
        var clicked = event.target;
        if (!clicked || !clicked.closest) return;
        if (clicked.closest("[data-cookie-accept]")) {
          saveConsent(consentAccepted);
          hideBanner();
          startTagsIfAccepted();
          return;
        }
        if (clicked.closest("[data-cookie-reject]")) {
          var wereLoaded = tagsLoaded;
          saveConsent(consentRejected);
          hideBanner();
          // Tags already running cannot be unloaded, so a reload is what actually stops them.
          if (wereLoaded) location.reload();
          return;
        }
        if (clicked.closest("[data-cookie-close]")) { hideBanner(); return; }
        if (clicked.closest("[data-cookie-settings]")) showBanner(!trackingAllowedHere);
      });

      var globalPrivacyControlOn = navigator.globalPrivacyControl === true;
      if (globalPrivacyControlOn) return;
      var timeZone = "";
      try { timeZone = Intl.DateTimeFormat().resolvedOptions().timeZone || ""; } catch (error) {}
      var inBlockedTimeZone = blockedTimeZonePrefixes.some(function (prefix) { return timeZone.indexOf(prefix) === 0; });
      if (inBlockedTimeZone) return;
      fetch(countryLookupPath, { cache: "no-store" })
        .then(function (response) { return response.ok ? response.text() : ""; })
        .then(function (traceText) {
          var countryMatch = /^loc=([A-Z]{2})$/m.exec(traceText);
          if (!countryMatch) return;
          if (blockedCountryCodes.indexOf(countryMatch[1]) !== -1) return;
          trackingAllowedHere = true;
          var consent = readConsent();
          if (consent === consentAccepted) { startTagsIfAccepted(); return; }
          if (consent === consentRejected) return;
          showBanner(false);
        })
        .catch(function () {});

      function isReferralPage() { return /^\/r(\/|$)/.test(location.pathname); }

      function loadTrackingTags() {
        // Microsoft Clarity
        (function(c,l,a,r,i,t,y){
            c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
            t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i+"?ref=bwt";
            y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
        })(window, document, "clarity", "script", clarityProjectId);
        // Google tag (Analytics)
        var googleTagScript = document.createElement("script");
        googleTagScript.async = true;
        googleTagScript.src = "https://www.googletagmanager.com/gtag/js?id=" + googleTagId;
        document.head.appendChild(googleTagScript);
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { window.dataLayer.push(arguments); };
        gtag('js', new Date());
        gtag('config', googleTagId, { send_page_view: false });
        // Reddit Pixel
        !function(w,d){if(!w.rdt){var p=w.rdt=function(){p.sendEvent?p.sendEvent.apply(p,arguments):p.callQueue.push(arguments)};p.callQueue=[];var t=d.createElement("script");t.src="https://www.redditstatic.com/ads/pixel.js",t.async=!0;var s=d.getElementsByTagName("script")[0];s.parentNode.insertBefore(t,s)}}(window,document);
        rdt('init','a2_jpb5d247ugq0');
        // Meta Pixel
        !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', '1107558851670464');

        // The first page view can arrive from both the call below and astro:page-load, so each URL is sent once.
        var lastTrackedUrl = "";
        function trackPageView() {
          if (isReferralPage()) return;
          if (lastTrackedUrl === location.href) return;
          lastTrackedUrl = location.href;
          rdt('track', 'PageVisit');
          fbq('track', 'PageView');
          gtag('event', 'page_view', { page_location: location.href, page_title: document.title });
        }
        // The lookup finishes after the first astro:page-load, so the first page view is sent here.
        trackPageView();
        document.addEventListener('astro:page-load', trackPageView);
        document.addEventListener('click', function (event) {
          var clicked = event.target;
          if (!clicked || !clicked.closest) return;
          if (isReferralPage()) return;
          if (!clicked.closest('a[href*="apps.apple.com"]')) return;
          rdt('track', 'SignUp');
          fbq('track', 'Lead');
        });
      }
    })();
  </script>
  )}
  {noindex && <meta name="robots" content="noindex" />}
  <title>{title}</title>
  <link rel="canonical" href={canonicalURL} />
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content={new URL(image, "https://cleanmailapp.com").href} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Cleanmail. Stop reading every email, just read the words that matter." />
  <meta property="og:url" content={canonicalURL} />
  <meta name="twitter:image" content={new URL(image, "https://cleanmailapp.com").href} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Cleanmail",
    "legalName": "Calibrate LLC",
    "url": "https://cleanmailapp.com",
    "logo": "https://cleanmailapp.com/logo.png",
    "sameAs": [...SOCIAL_PROFILE_URLS, APP_STORE_URL],
    "founder": { "@type": "Person", "name": "Zachary Asher" },
    "description": "Cleanmail turns school, camp, and sports emails into one AI-powered digest organized by person and activity, with every date synced to your calendar."
  })} />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "MobileApplication",
    "name": APP_STORE_NAME,
    "alternateName": "Cleanmail",
    "disambiguatingDescription":"Family inbox app for parents by Calibrate LLC. Not affiliated with Clean Email (inbox cleanup) or CleanMail.dev (email verification).",
    "applicationCategory": "LifestyleApplication",
    "operatingSystem": "iOS",
    "url": "https://cleanmailapp.com",
    "installUrl": APP_STORE_URL,
    "downloadUrl": APP_STORE_URL,
    "sameAs": [APP_STORE_URL],
    "image": "https://cleanmailapp.com/og.png",
    "screenshot": "https://cleanmailapp.com/Digest_Sample.png",
    "author": { "@type": "Organization", "name": "Calibrate LLC" },
    "publisher": { "@type": "Organization", "name": "Calibrate LLC" },
    "description": "Cleanmail connects directly to Gmail and turns school, camp, and sports emails into one AI-powered digest organized by person and activity. It extracts the important dates and keeps them in dedicated two-way sync with your Google Calendar, so you read less email and never miss what matters. Read-only access. Your digest only covers the senders you pick.",
    "offers": [
      {
        "@type": "Offer",
        "price": "6.99",
        "priceCurrency": "USD",
        "description": "6.99 US dollars per month with a 14-day free trial",
        "url": APP_STORE_URL
      },
      {
        "@type": "Offer",
        "price": "68.99",
        "priceCurrency": "USD",
        "description": "68.99 US dollars per year, two months free, with a 14-day free trial",
        "url": APP_STORE_URL
      }
    ],
    "featureList": [
      "Connects directly to Gmail with no forwarding or manual entry",
      "AI digest organized by person and activity",
      "Automatically extracts events and puts them on Google Calendar",
      "Dedicated two-way Google Calendar sync: edits and deletes made in Google Calendar flow back to Cleanmail",
      "Upcoming Events timeline of every date from your inbox",
      "Daily or weekly digest scheduling",
      "Track up to 8 people in one digest",
      "Share one digest across a household of up to 4 members",
      "Link up to 3 Gmail inboxes into one digest",
      "Read-only Gmail access, and your digest only covers the senders you pick"
    ]
  })} />

  <ClientRouter />
  <style is:global>
    :root{
      --purple:#4A6FE3; --orange:#E88C30; --green:#66EE78; --teal:#5dc4b8;
      --navy:#1b2236; --ink:#3a4156; --muted:#7a8196;
      --card:#f7f9ff; --line:#e6ebf6;
    }
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    html{scroll-behavior:smooth}
    body{font-family:"Helvetica Neue",Helvetica,-apple-system,BlinkMacSystemFont,"Segoe UI",Arial,sans-serif;color:var(--navy);background:#fff;-webkit-font-smoothing:antialiased}
    .page{
      position:relative;min-height:100vh;display:flow-root;
      background:
        radial-gradient(1250px 1250px at 0% 0%, rgba(74,111,227,.34) 0%, rgba(74,111,227,.13) 15%, rgba(74,111,227,0) 58%),
        radial-gradient(1250px 1250px at 100% 0%, rgba(74,111,227,.32) 0%, rgba(74,111,227,.12) 15%, rgba(74,111,227,0) 58%),
        radial-gradient(1480px 1480px at 0% 100%, rgba(232,140,48,.42) 0%, rgba(232,140,48,.17) 16%, rgba(232,140,48,0) 62%),
        radial-gradient(1480px 1480px at 100% 100%, rgba(232,140,48,.40) 0%, rgba(232,140,48,.16) 16%, rgba(232,140,48,0) 62%),
        #ffffff;
    }
    .cookie-banner{position:fixed;left:50%;bottom:16px;transform:translateX(-50%);z-index:80;width:calc(100% - 32px);max-width:640px;display:flex;align-items:center;gap:16px;padding:14px 16px;background:#fff;border:1px solid rgba(27,34,54,.14);border-radius:16px;box-shadow:0 12px 34px rgba(27,34,54,.16);color:#1b2236;font-size:14px;line-height:1.4}
    .cookie-banner[hidden]{display:none}
    .cookie-banner p{margin:0;flex:1}
    .cookie-banner a{color:#2D4BAD}
    .cookie-actions{display:flex;gap:10px}
    .cookie-choice{min-width:96px;padding:10px 16px;font:inherit;font-weight:600;color:#1b2236;background:#fff;border:1.5px solid #1b2236;border-radius:10px;cursor:pointer}
    .cookie-choice:hover{background:#f2f5fe}
    .cookie-choice:focus-visible{outline:3px solid #4A6FE3;outline-offset:2px}
    .cookie-banner.region-off [data-cookie-accept]{display:none}
    .cookie-banner.region-off [data-cookie-reject]{display:none}
    .cookie-close{display:none}
    .cookie-banner.region-off .cookie-close{display:inline-block}
    @media(max-width:560px){.cookie-banner{flex-direction:column;align-items:stretch}.cookie-actions .cookie-choice{flex:1}}
  </style>
</head>
<body>
  <div class="page">
    <Nav />
    <slot />
    <Footer />
  </div>
  <div id="cookie-banner" class="cookie-banner" role="region" aria-label="Cookie choices" transition:persist hidden>
    <p data-cookie-message>{COOKIE_CONSENT_MESSAGE} <a href="/privacy">Privacy Policy</a></p>
    <div class="cookie-actions">
      <button type="button" class="cookie-choice" data-cookie-reject>Reject</button>
      <button type="button" class="cookie-choice" data-cookie-accept>Accept</button>
      <button type="button" class="cookie-choice cookie-close" data-cookie-close>Close</button>
    </div>
  </div>
  <script>
    function playHeroVideo() {
      document.querySelectorAll("video.hero-video").forEach((v) => {
        v.muted = true;
        const go = () => { const p = v.play(); if (p && p.catch) p.catch(() => {}); };
        go();
        v.addEventListener("canplay", go, { once: true });
        v.addEventListener("loadeddata", go, { once: true });
      });
    }
    playHeroVideo();
    document.addEventListener("astro:page-load", playHeroVideo);
  </script>
</body>
</html>
