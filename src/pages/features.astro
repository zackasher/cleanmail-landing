---
import BaseLayout from "../layouts/BaseLayout.astro";
import PhoneFrame from "../components/PhoneFrame.astro";
import CTA from "../components/CTA.astro";

const voiceBars = [
  { left: 26.12, top: 46.17, height: 5.67, color: "#E5C2A1" },
  { left: 31.72, top: 45.07, height: 7.86, color: "#E6AE72" },
  { left: 37.32, top: 44.21, height: 9.59, color: "#DC9044" },
  { left: 42.92, top: 43.23, height: 11.54, color: "#586CAF" },
  { left: 48.52, top: 42.18, height: 13.65, color: "#526EDB" },
  { left: 54.11, top: 43.19, height: 11.62, color: "#586CAF" },
  { left: 59.71, top: 44.29, height: 9.43, color: "#DC9044" },
  { left: 65.31, top: 45.38, height: 7.24, color: "#E6AE72" },
  { left: 70.91, top: 46.79, height: 4.42, color: "#E5C2A1" },
];
---
<BaseLayout title="Features | Cleanmail" description="The mail and events that matter, sorted, and already on your calendar.">
  <section class="features-show">
    <p class="eyebrow">Features</p>
    <h1 class="show-title">Just what you <span class="pop">need</span>. Nothing you don't.</h1>
    <p class="show-sub">No feature dump. Here is the short list of things Cleanmail&trade; does, and does well.</p>

    <div class="sec">
      <svg class="sec-shield" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.4l8 3v5.6c0 5.3-3.4 8.9-8 10.5-4.6-1.6-8-5.2-8-10.5V5.4l8-3z" fill="currentColor"/><rect x="9" y="11.2" width="6" height="5.2" rx="1.1" fill="#fff"/><path d="M10.3 11.2V9.8a1.7 1.7 0 013.4 0v1.4" fill="none" stroke="#fff" stroke-width="1.5" stroke-linecap="round"/></svg>
      <h2 class="sec-title">Trusted with the family inbox.</h2>
      <p class="sec-body">Cleanmail connects to Gmail read-only and only ever opens mail from the senders you pick. Everything else in your inbox stays untouched, and nothing you share is ever sold.</p>
      <ul class="sec-pills">
        <li><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10" fill="currentColor"/><path d="M7.5 12.4l3.1 3.1 6-6.2" fill="none" stroke="#fff" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/></svg>Gmail stays read-only</li>
        <li><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10" fill="currentColor"/><path d="M7.5 12.4l3.1 3.1 6-6.2" fill="none" stroke="#fff" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/></svg>Only senders you pick</li>
        <li><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10" fill="currentColor"/><path d="M7.5 12.4l3.1 3.1 6-6.2" fill="none" stroke="#fff" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/></svg>Encrypted</li>
        <li><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10" fill="currentColor"/><path d="M7.5 12.4l3.1 3.1 6-6.2" fill="none" stroke="#fff" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/></svg>Never sold</li>
      </ul>
      <p class="sec-casa">Cleanmail passed Google's CASA security assessment, the independent review Google requires of any app that connects to Gmail. <a href="/privacy">Read the privacy policy</a></p>
    </div>

    <div class="demo">
      <div class="demo-text">
        <h2>See it in action</h2>
        <p class="demo-sub">One photo. 41 smart events. One Clean Mailbox.</p>
        <ol class="demo-beats">
          <li><span>1</span>Snap the paper calendar or flyer.</li>
          <li><span>2</span>Cleanmail pulls out every date.</li>
          <li><span>3</span>They land on your calendar, sorted by person.</li>
        </ol>
      </div>
      <div class="demo-phone">
        <PhoneFrame>
          <video class="demo-video" autoplay muted loop playsinline preload="auto" poster="/feat-demo-poster.jpg">
            <source src="/feat-demo.mp4" type="video/mp4" />
          </video>
        </PhoneFrame>
      </div>
    </div>

    <div class="marquee">
      <p class="mq-kicker">The whole point</p>
      <h2 class="mq-title">Sorted by <span class="pop">person</span>, not by sender.</h2>
      <p class="mq-body">Cleanmail sorts the school, camp, and activity mail by the people you care about, then breaks each thread into short, plain-language snippets. You get your whole family's week at a glance, without reading a single full email. And your calendar stays yours: keep it private inside Cleanmail, or share it with your household so everyone sees the same schedule.</p>
      <img class="mq-shot" src="/mq-digest.jpg" alt="A Cleanmail digest sorted by person, showing a child's camp events" />
    </div>

    <div class="scroller-wrap">
      <button class="scroll-btn prev" type="button" aria-label="Previous features">‹</button>
      <div class="feat-scroller" id="featScroller">
      <div class="feat"><h3>Snap anything</h3><p>See a flyer, yard sign, or calendar? Snap it, upload it, add it all instantly.</p><img class="feat-shot" src="/feat-snap.jpg" alt="Adding an event by snapping a flyer or photo" /></div>
      <div class="feat"><h3>Week or month</h3><p>Always up to date. Scan the week as a list, or open the month to see it all at once.</p><img class="feat-shot" src="/feat-weekly.jpg" alt="The month view with dots on busy days and the day's events listed below" /></div>
      <div class="feat"><h3>Add anything</h3><p>Not everything comes by email. Add custom events by photo, tap, or voice.</p><img class="feat-shot" src="/feat-add.jpg" alt="The add-an-event menu with type, photos, camera, PDF, and voice options" /></div>
      <div class="feat"><h3>Two-way calendar</h3><p>Dedicated two-way Google Calendar sync. Pick your main calendar, then change it anywhere and it changes everywhere.</p><img class="feat-shot" src="/feat-calendar.jpg" alt="Calendar settings: which calendars to show, and the main calendar Cleanmail writes to" /></div>
      <div class="feat"><h3>Cancellations, caught</h3><p>Did the school email to cancel an event? It's now cancelled in Cleanmail and on your Google Calendar too.</p><img class="feat-shot" src="/feat-cancel.jpg" alt="A dress rehearsal marked cancelled, with its old time crossed out" /></div>
      <div class="feat"><h3>Household &amp; inboxes</h3><p>Share one digest with up to four people, and pull up to three Gmail inboxes into it. Everyone and everything in one place.</p><img class="feat-shot" src="/feat-household.jpg" alt="A household of up to four people, plus linked inboxes, feeding one digest" /></div>
      <div class="feat"><h3>Notes &amp; reactions</h3><p>Leave a quick note or a reaction on any card, and the whole household sees it.</p><img class="feat-shot" src="/feat-notes.jpg" alt="A school event with a household note asking for a ride, and a reaction on the card" /></div>
      <div class="feat"><h3>Reminders</h3><p>A nudge before each event, so nothing ever sneaks up on you.</p><img class="feat-shot" src="/feat-reminders.jpg" alt="Choosing a reminder: the day before, the morning of, or an hour before" /></div>
      <div class="feat"><h3>Voice edits</h3><p>Change any event's time out loud. Cleanmail hears you and updates it.</p><div class="voice-shot"><img class="feat-shot" src="/feat-voice.jpg" alt="Adding an event by voice, with a live waveform" /><div class="voice-bars" aria-hidden="true">{voiceBars.map((bar, index) => <span style={`left:${bar.left}%;top:${bar.top}%;height:${bar.height}%;background:${bar.color};animation-delay:${-index * 0.13}s`} />)}</div></div></div>
      </div>
      <button class="scroll-btn next" type="button" aria-label="Next features">›</button>
    </div>

    <div class="more">
      <h2>A few more things</h2>
      <p class="more-sub">Small, but they earn their place.</p>
      <div class="more-list">
        <div class="more-item"><svg class="chk" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7"/></svg><p><b>Instant updates.</b> <span>The moment an email arrives, it's already waiting in Cleanmail, no refreshing.</span></p></div>
        <div class="more-item"><svg class="chk" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7"/></svg><p><b>Pinned events.</b> <span>Keep the big ones stuck to the top of your digest.</span></p></div>
        <div class="more-item"><svg class="chk" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7"/></svg><p><b>Smart senders.</b> <span>Name an activity and Cleanmail finds the senders that fit, groups a company's many addresses into one, and moves a sender to another person in a tap.</span></p></div>
        <div class="more-item"><svg class="chk" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7"/></svg><p><b>Tap straight through.</b> <span>Cards from your inbox link back to the email they came from, and any address opens in maps.</span></p></div>
        <div class="more-item"><svg class="chk" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7"/></svg><p><b>Changes, shown.</b> <span>When a correction comes back as a reply on the same email thread, the event updates and the old time stays crossed out underneath.</span></p></div>
        <div class="more-item"><svg class="chk" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7"/></svg><p><b>Searchable history.</b> <span>Past digests stay searchable for the detail you need weeks later.</span></p></div>
      </div>
    </div>

    <div class="features-cta"><CTA /></div>
  </section>
</BaseLayout>

<script>
  function initScroller(){
    const sc=document.getElementById('featScroller');
    if(!sc||sc.dataset.bound) return; sc.dataset.bound='1';
    const step=()=>{const c=sc.querySelector('.feat');return (c?c.getBoundingClientRect().width:330)+18;};
    const prev=document.querySelector('.scroll-btn.prev'), next=document.querySelector('.scroll-btn.next');
    prev&&prev.addEventListener('click',()=>sc.scrollBy({left:-step(),behavior:'smooth'}));
    next&&next.addEventListener('click',()=>sc.scrollBy({left:step(),behavior:'smooth'}));
  }
  function playDemo(){
    const v=document.querySelector('.demo-video');
    if(!v) return;
    v.muted=true;
    const go=()=>{const p=v.play();if(p&&p.catch)p.catch(()=>{});};
    go();
    v.addEventListener('canplay',go,{once:true});
    v.addEventListener('loadeddata',go,{once:true});
  }
  document.addEventListener('astro:page-load', ()=>{initScroller();playDemo();});
  if(document.readyState!=='loading'){initScroller();playDemo();}
</script>

<style>
  .features-show{max-width:960px;margin:0 auto;padding:54px 24px 96px}
  .features-show .eyebrow{text-align:center;text-transform:uppercase;letter-spacing:1.5px;font-size:12.5px;font-weight:600;color:var(--purple);margin:0 0 14px}
  .show-title{text-align:center;font-size:clamp(26px,3.6vw,40px);font-weight:400;letter-spacing:-1px;color:var(--navy);margin:14px 0 10px}
  .show-sub{text-align:center;color:var(--muted);font-size:16.5px;line-height:1.55;margin:0 auto 48px;max-width:560px}
  .pop{color:var(--orange)}

  .sec{text-align:center;background:linear-gradient(135deg,rgba(74,111,227,.08),rgba(93,196,184,.10));border:1px solid var(--line);border-radius:24px;padding:34px 28px 30px;margin-bottom:56px}
  .sec-shield{width:52px;height:52px;color:var(--purple);display:block;margin:0 auto 14px}
  .sec-title{font-size:clamp(21px,2.8vw,29px);font-weight:500;letter-spacing:-.5px;color:var(--navy);margin:0 0 12px}
  .sec-body{font-size:16px;line-height:1.65;color:var(--ink);max-width:540px;margin:0 auto 22px}
  .sec-pills{list-style:none;margin:0 0 20px;padding:0;display:flex;flex-wrap:wrap;justify-content:center;gap:10px}
  .sec-pills li{display:inline-flex;align-items:center;gap:8px;background:#fff;border:1px solid var(--line);border-radius:999px;padding:9px 17px 9px 13px;font-size:14.5px;font-weight:500;color:var(--navy);box-shadow:0 5px 14px rgba(27,34,54,.06)}
  .sec-pills svg{width:19px;height:19px;color:var(--teal);flex:0 0 auto}
  .sec-casa{font-size:13.5px;line-height:1.55;color:var(--muted);max-width:520px;margin:0 auto}
  .sec-casa a{color:var(--purple);text-decoration:none;font-weight:500;white-space:nowrap}
  .sec-casa a:hover{text-decoration:underline}

  .demo{display:flex;align-items:center;justify-content:center;gap:60px;text-align:left;margin-bottom:56px}
  .demo-text{flex:1 1 0;max-width:400px}
  .demo h2{font-size:clamp(24px,3.4vw,36px);font-weight:500;letter-spacing:-.8px;color:var(--navy);margin:0 0 12px;line-height:1.1}
  .demo-sub{color:var(--muted);font-size:17px;line-height:1.55;margin:0}
  .demo-beats{list-style:none;margin:26px 0 0;padding:0;display:flex;flex-direction:column;gap:14px}
  .demo-beats li{display:flex;align-items:center;gap:13px;font-size:15.5px;line-height:1.45;color:var(--ink)}
  .demo-beats span{flex:0 0 auto;width:27px;height:27px;border-radius:50%;background:var(--purple);color:#fff;font-size:13.5px;font-weight:600;display:flex;align-items:center;justify-content:center}
  .demo-phone{flex:0 0 auto;width:380px;max-width:100%}
  .demo-video{width:100%;height:100%;object-fit:cover;display:block}

  .marquee{background:linear-gradient(135deg,rgba(74,111,227,.09),rgba(93,196,184,.11));border:1px solid var(--line);border-radius:24px;padding:34px 30px;text-align:center;margin-bottom:48px}
  .mq-kicker{text-transform:uppercase;letter-spacing:1.4px;font-size:11.5px;font-weight:600;color:var(--teal);margin:0 0 10px}
  .mq-title{font-size:clamp(22px,3vw,32px);font-weight:500;letter-spacing:-.6px;color:var(--navy);margin:0 0 14px}
  .mq-body{font-size:16px;line-height:1.65;color:var(--ink);max-width:580px;margin:0 auto}
  .mq-shot{display:block;width:100%;max-width:330px;margin:26px auto 0;border-radius:16px;border:1px solid var(--line);box-shadow:0 12px 30px rgba(27,34,54,.10)}

.scroller-wrap{position:relative;margin:0}
  .feat-scroller{display:flex;gap:18px;overflow-x:auto;scroll-snap-type:x mandatory;scroll-padding:20px;padding:20px;border:1px solid var(--purple);border-radius:24px;scrollbar-width:none;-webkit-overflow-scrolling:touch}
  .feat-scroller::-webkit-scrollbar{display:none}
  .feat{flex:0 0 330px;scroll-snap-align:start;display:flex;flex-direction:column;background:#fff;border:1px solid var(--line);border-radius:20px;padding:22px 20px;box-shadow:0 8px 24px rgba(27,34,54,.05)}
  .feat h3{font-size:17.5px;font-weight:600;color:var(--navy);margin:0 0 7px;letter-spacing:-.2px}
  .feat p{font-size:14px;line-height:1.55;color:var(--muted);margin:0 0 16px}
  .feat-shot{width:100%;height:auto;display:block;border-radius:14px;border:1px solid var(--line);margin-top:auto}
  .voice-shot{position:relative;margin-top:auto}
  .voice-bars span{position:absolute;width:3.05%;border-radius:999px;transform-origin:center;animation:voice-pulse 1.1s ease-in-out infinite alternate}
  .voice-bars span:nth-child(odd){animation-duration:.9s}
  .voice-bars span:nth-child(3n){animation-duration:1.3s}
  @keyframes voice-pulse{0%{transform:scaleY(.45)}50%{transform:scaleY(1.05)}100%{transform:scaleY(.7)}}
  @media (prefers-reduced-motion:reduce){.voice-bars span{animation:none}}
  .scroll-btn{display:none}
  @media (min-width:821px){
    .scroll-btn{display:flex;align-items:center;justify-content:center;position:absolute;top:50%;transform:translateY(-50%);z-index:5;width:44px;height:44px;border-radius:50%;background:var(--purple);border:none;box-shadow:0 6px 18px rgba(74,111,227,.4);color:#fff;font-size:24px;cursor:pointer;line-height:0;padding-bottom:3px}
    .scroll-btn.prev{left:-14px}
    .scroll-btn.next{right:-14px}
    .scroll-btn:hover{filter:brightness(0.93)}
  }

  .more{margin-top:44px}
  .more h2{text-align:center;font-size:clamp(21px,2.6vw,27px);font-weight:400;letter-spacing:-.5px;color:var(--navy);margin:0 0 6px}
  .more-sub{text-align:center;color:var(--muted);font-size:15px;margin:0 0 30px}
  .more-list{display:grid;grid-template-columns:1fr 1fr;gap:18px 30px}
  .more-item{display:flex;gap:11px;align-items:flex-start}
  .more-item .chk{width:19px;height:19px;color:var(--teal);flex:0 0 auto;margin-top:2px}
  .more-item p{margin:0;font-size:15px;line-height:1.5}
  .more-item b{color:var(--navy);font-weight:600}
  .more-item span{color:var(--muted)}

  .features-cta{margin-top:60px}

  @media (max-width:820px){
    .demo{flex-direction:column;text-align:center;gap:30px}
    .demo-text{max-width:520px}
    .demo-phone{width:300px}
  }
  @media (max-width:820px){ .feat{flex:0 0 300px} }
  @media (max-width:640px){
    .more-list{grid-template-columns:1fr;gap:16px}
    .marquee{padding:28px 22px}
  }
  @media (max-width:520px){ .feat{flex:0 0 80vw} }
</style>
