---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { publishedPosts, formatPostDate } from "../../data-blog";
import "../../styles/info-page.css";

const posts = publishedPosts();
---
<BaseLayout title="Blog: School Email, Family Calendars, and Busy Weeks | Cleanmail" description="Practical help for parents juggling school email, activity schedules, and a shared family calendar. From the team behind Cleanmail.">
  <section class="ip">
    <p class="ip-eyebrow">Blog</p>
    <h1>Help for the busiest inbox in the house.</h1>
    <p class="ip-lede">Practical answers for parents juggling school email, activity schedules, and one shared family calendar.</p>
    <div class="post-list">
      {posts.map((post) => (
        <a class="post-card" href={`/blog/${post.slug}`}>
          <span class="post-date">{formatPostDate(post.frontmatter.date)}</span>
          <h2>{post.frontmatter.title}</h2>
          <p>{post.frontmatter.description}</p>
          <span class="post-more">Read it <span aria-hidden="true">›</span></span>
        </a>
      ))}
    </div>
  </section>
  <style>
    .post-list{max-width:720px;margin:48px auto 0;display:flex;flex-direction:column;gap:16px}
    .post-card{display:block;text-decoration:none;background:#fff;border:1px solid var(--line);border-radius:20px;padding:22px 24px;box-shadow:0 8px 22px rgba(27,34,54,.05);transition:transform .15s}
    .post-card:hover{transform:translateY(-2px)}
    .post-date{font-size:13px;color:var(--muted)}
    .post-card h2{margin:6px 0 6px;font-size:21px;font-weight:600;color:var(--navy);letter-spacing:-.3px}
    .post-card p{margin:0;font-size:15.5px;line-height:1.5;color:var(--ink)}
    .post-more{display:inline-block;margin-top:10px;font-size:14.5px;font-weight:600;color:var(--purple)}
  </style>
</BaseLayout>
