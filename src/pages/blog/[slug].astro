---
import { pageTitle } from "../../page-title";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CTA from "../../components/CTA.astro";
import { publishedPosts, relatedPosts, formatPostDate, type BlogPost } from "../../data-blog";
import BlogReads from "../../components/BlogReads.astro";
import { AUTHOR_PATH, BLOG_SHARE_IMAGE_DIRECTORY, FOUNDER_NAME, RELATED_POSTS_COUNT, SCHEMA_PAGE_TYPE_NONE, SITE_URL, TRIAL_DAYS, TRIAL_TERMS } from "../../config";
import { FOUNDER_PERSON } from "../../data/founder-schema";
import { existsSync } from "node:fs";
import "../../styles/info-page.css";

export function getStaticPaths() {
  return publishedPosts().map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props as { post: BlogPost };
const { title, seoTitle, description, date, updated, author, faqs = [] } = post.frontmatter;
const isFounderPost = author === FOUNDER_NAME;
const shareImagePath = `${BLOG_SHARE_IMAGE_DIRECTORY}/${post.slug}.png`;
// ponytail: a post without a generated card falls back to the site-wide /og.png instead of failing the build.
const shareImage = existsSync(`public${shareImagePath}`) ? shareImagePath : undefined;
const { Content } = post;
const relatedPostSlugs = relatedPosts(post, RELATED_POSTS_COUNT).map((relatedPost) => relatedPost.slug);

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "description": description,
  "datePublished": date,
  "dateModified": updated ?? date,
  "author": isFounderPost ? FOUNDER_PERSON : { "@type": "Person", "name": author },
  "publisher": { "@type": "Organization", "name": "Cleanmail", "url": SITE_URL },
  "mainEntityOfPage": `${SITE_URL}/blog/${post.slug}`,
  ...(shareImage && { "image": `${SITE_URL}${shareImage}` }),
};
const hasFaqs = faqs.length > 0;
const faqSchema = hasFaqs ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((item) => ({ "@type": "Question", "name": item.q, "acceptedAnswer": { "@type": "Answer", "text": item.a } })),
} : undefined;
---
<BaseLayout schemaPageType={SCHEMA_PAGE_TYPE_NONE} title={pageTitle(seoTitle ?? title)} description={description} faqSchema={faqSchema} image={shareImage} imageAlt={shareImage && title}>
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <article class="ip post">
    <p class="ip-eyebrow"><a href="/blog">Blog</a></p>
    <h1>{title}</h1>
    <p class="post-byline">By {isFounderPost ? <a href={AUTHOR_PATH} rel="author">{author}</a> : author} · {formatPostDate(date)}</p>
    <div class="post-body"><Content /></div>
    {hasFaqs && (
      <div class="ip-section">
        <h2>Quick answers</h2>
        <div class="ip-faq">
          {faqs.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    )}
    <div class="ip-final">
      <h2>Try Cleanmail free for {TRIAL_DAYS} days</h2>
      <p>{TRIAL_TERMS} School and activity email, sorted by kid, with the dates on your family calendar.</p>
      <CTA />
    </div>
  </article>
  <BlogReads slugs={relatedPostSlugs} />
  <style>
    .post .ip-eyebrow a{color:inherit;text-decoration:none}
    .post-byline a{color:inherit}
    .post-byline{text-align:center;font-size:14px;color:var(--muted);margin:10px 0 0}
    .post-body{max-width:680px;margin:40px auto 0;font-size:17.5px;line-height:1.7;color:var(--ink)}
    .post-body :global(h2){font-size:25px;font-weight:600;color:var(--navy);margin:38px 0 10px;letter-spacing:-.3px;text-align:left}
    .post-body :global(p){margin:0 0 18px}
    .post-body :global(ul),.post-body :global(ol){margin:0 0 18px;padding-left:22px}
    .post-body :global(li){margin-bottom:8px}
    .post-body :global(a){color:var(--purple)}
    .post-body :global(table){display:block;max-width:100%;overflow-x:auto;border-collapse:collapse;margin:0 0 18px;font-size:14px;line-height:1.45}
    .post-body :global(th),.post-body :global(td){border:1px solid var(--line);padding:8px 10px;text-align:left;vertical-align:top}
    .post-body :global(th){background:#f6f7fb;color:var(--navy);font-weight:600;white-space:nowrap}
  </style>
</BaseLayout>
