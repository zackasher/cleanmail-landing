---
import { pageTitle } from "../page-title";
import BaseLayout from "../layouts/BaseLayout.astro";
import PhoneFrame from "../components/PhoneFrame.astro";
import CTA from "../components/CTA.astro";
import BlogReads from "../components/BlogReads.astro";
import { BLOG_SLUG_STOP_MISSING_EMAILS } from "../config";

// The 1.0.7 onboarding: set up first, see your own first digest, then choose a plan.
// Names and senders in these screens are invented examples, never a real family.
const setupSteps = [
  {
    title: "Connect your Gmail",
    body: "Sign in with Google and allow email and calendar access. Cleanmail only reads mail from the senders you choose, never sends or deletes anything, and never sells your information.",
    image: "/hiw107-welcome.jpg",
    alt: "The Cleanmail welcome screen: Inbox to calendar, automatically, with a Connect your Gmail button",
  },
  {
    title: "Tell it who",
    body: "Your kids, yourself, even the dog. Add a name and a photo for each, so everything lands in the right place.",
    image: "/hiw107-who.jpg",
    alt: "Choosing who to keep track of, with a child and a pet added",
  },
  {
    title: "Pick their activities",
    body: "Cleanmail suggests the activities each person gets email about: school, soccer, scouts, the vet. Tap the ones that fit, or add your own.",
    image: "/hiw107-activities.jpg",
    alt: "Suggested activities for each person, with school and soccer selected",
  },
  {
    title: "Choose the senders",
    body: "We find the people who email you about each activity and tag them: good senders first, quiet ones and likely junk marked so you can skip them. You check the ones that matter.",
    image: "/hiw107-senders.jpg",
    alt: "Senders found for each activity, tagged as good senders or possible junk",
  },
  {
    title: "Watch your first digest build",
    body: "Cleanmail reads those emails, pulls out the dates, and checks them against your Google Calendar. It takes about a minute.",
    image: "/hiw107-building.jpg",
    alt: "Building your first digest, with a quick tip card about the app",
  },
  {
    title: "See it before you pay",
    body: "Your first digest is on us. You see how many emails it found and which events aren't on your calendar yet, with one card shown in full.",
    image: "/hiw107-teaser.jpg",
    alt: "The first digest preview: emails found, events not on the calendar yet, and one event card in full",
  },
  {
    title: "Start your free trial",
    body: "Fourteen days free, then monthly or yearly, through your Apple Account. When your trial starts, the events from your first digest land on your Google Calendar and Cleanmail keeps running on its own.",
    image: "/hiw107-plan.jpg",
    alt: "The plan screen: your first digest is ready, a 14-day free trial, then yearly or monthly",
  },
];

const oldWay = [
  "Forward emails to an app, one at a time",
  "Type every date into a calendar yourself",
  "Check ParentSquare, Remind, and email separately",
  "Dig through the inbox for the permission slip",
  "Miss the one email that actually mattered",
];

const newWay = [
  "Connect Gmail once, read-only",
  "Your digest only covers the senders you pick",
  "ParentSquare and Remind emails handled like any sender",
  "Sorted by kid and activity, shared with your household",
  "Every date on your Google Calendar, both ways",
];
---
<BaseLayout
  title={pageTitle("How It Works")}
  description="Set up Cleanmail in a few minutes, see your first digest from your own email before you pay, then let it put every school and activity date on your Google Calendar."
>
  <section class="hiw">
    <p class="eyebrow">How it works</p>
    <h1>Set it up once. See it before you pay.</h1>
    <p class="lede">Tell Cleanmail who and what matters, pick the senders, and watch your first digest build from your own email. You see what it found before you choose a plan. Then it runs on its own.</p>

    <div class="steps">
      {setupSteps.map((step, index) => (
        <div class:list={["step", { flip: index % 2 === 1 }]}>
          <div class="step-text">
            <span class="step-num">Step {index + 1}</span>
            <h2>{step.title}</h2>
            <p>{step.body}</p>
          </div>
          <div class="step-visual">
            <PhoneFrame>
              <img class="shot" src={step.image} alt={step.alt} loading="lazy" />
            </PhoneFrame>
          </div>
        </div>
      ))}
    </div>

    <div class="capture">
      <h2>And when it isn't in your inbox</h2>
      <p>Some things never hit your email: the flyer on the fridge, the field-trip form, the coach reading out dates. Snap it, upload it, or just say it out loud, and it lands in the same clean digest.</p>
      <div class="capture-icons" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 8h3l1.5-2h7L17 8h3a1 1 0 011 1v9a1 1 0 01-1 1H4a1 1 0 01-1-1V9a1 1 0 011-1z"/><circle cx="12" cy="13" r="3.2"/></svg>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="5" width="17" height="14" rx="2.5"/><circle cx="8.5" cy="10" r="1.6"/><path d="M20 16l-4.5-4.5L6 20"/></svg>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="9.5" y="3" width="5" height="10" rx="2.5"/><path d="M6.5 11a5.5 5.5 0 0011 0M12 16.5V20M9 20h6"/></svg>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M7 3.5h7l4 4V20a1 1 0 01-1 1H7a1 1 0 01-1-1V4.5a1 1 0 011-1z"/><path d="M14 3.5V8h4"/></svg>
      </div>
    </div>

    <div class="compare">
      <div class="col old">
        <h3>The old way</h3>
        <ul>
          {oldWay.map((item) => (
            <li>
              <svg class="ic x" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="col new">
        <h3>With Cleanmail</h3>
        <ul>
          {newWay.map((item) => (
            <li>
              <svg class="ic check" viewBox="0 0 16 16" aria-hidden="true"><path d="M13 4.5 6.5 11 3 7.5" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <BlogReads slugs={[BLOG_SLUG_STOP_MISSING_EMAILS]} />

    <div class="final">
      <h2>See it for yourself</h2>
      <p>Sign in is quick, and then it runs on its own.</p>
      <CTA />
    </div>

  </section>

  <style>
    .hiw{max-width:1040px;margin:0 auto;padding:80px 24px 90px}
    .eyebrow{text-align:center;text-transform:uppercase;letter-spacing:1.5px;font-size:12.5px;font-weight:600;color:var(--purple);margin:0 0 14px}
    h1{text-align:center;font-size:clamp(30px,4.6vw,46px);font-weight:400;letter-spacing:-1.2px;color:var(--navy);margin:0 0 16px;line-height:1.08}
    .lede{text-align:center;max-width:560px;margin:0 auto;color:var(--ink);font-size:17px;line-height:1.55}

    .steps{display:flex;flex-direction:column;gap:72px;margin-top:72px}
    .step{display:flex;align-items:center;gap:56px}
    .step.flip{flex-direction:row-reverse}
    .step-text{flex:1;max-width:460px;background:#fff;border:1.5px solid rgba(74,111,227,.40);border-radius:20px;padding:24px;box-shadow:0 10px 30px rgba(27,34,54,.05)}
    .step-visual{flex:1;display:flex;justify-content:center}
    .step-num{position:relative;overflow:hidden;display:block;font-size:clamp(18px,2.2vw,22px);font-weight:500;letter-spacing:-.2px;color:#fff;background:var(--purple);padding:7px 20px;border-radius:10px;margin-bottom:10px;box-shadow:0 8px 20px rgba(74,111,227,.22)}
    .step-num::after{content:"";position:absolute;right:0;bottom:0;width:40px;height:40px;background:rgba(0,0,0,.15);clip-path:polygon(100% 0,100% 100%,0 100%)}
    .step h2{position:relative;overflow:hidden;font-size:clamp(18px,2.2vw,22px);font-weight:500;color:#fff;background:var(--teal);padding:8px 20px;border-radius:10px;margin:0 0 14px;letter-spacing:-.2px;box-shadow:0 8px 20px rgba(93,196,184,.22)}
    .step h2::after{content:"";position:absolute;right:0;bottom:0;width:44px;height:44px;background:rgba(0,0,0,.15);clip-path:polygon(100% 0,100% 100%,0 100%)}
    .step p{font-size:17px;line-height:1.6;color:var(--ink);background:var(--card);border:1px solid var(--line);border-radius:16px;padding:17px 20px;margin:0;box-shadow:0 8px 22px rgba(27,34,54,.05)}
    .shot{width:100%;height:100%;object-fit:cover;object-position:top center;display:block}

    .capture{margin-top:80px;background:linear-gradient(135deg,rgba(74,111,227,.08),rgba(93,196,184,.10));border:1px solid var(--line);border-radius:22px;padding:34px 28px;text-align:center}
    .capture h2{font-size:clamp(20px,2.6vw,27px);font-weight:500;letter-spacing:-.5px;color:var(--navy);margin:0 0 12px}
    .capture p{font-size:16px;line-height:1.6;color:var(--ink);max-width:520px;margin:0 auto 22px}
    .capture-icons{display:flex;justify-content:center;gap:20px;color:var(--purple)}
    .capture-icons svg{width:30px;height:30px}

    .compare{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:88px}
    .col{border:1px solid var(--line);border-radius:18px;padding:28px 26px;background:#fff}
    .col.old{background:var(--card)}
    .col h3{font-size:16px;font-weight:600;margin:0 0 18px;color:var(--navy)}
    .col.old h3{color:var(--muted)}
    .col ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:13px}
    .col li{display:flex;align-items:flex-start;gap:11px;font-size:15px;line-height:1.4;color:var(--ink)}
    .col.old li{color:var(--muted)}
    .ic{width:16px;height:16px;flex-shrink:0;margin-top:1px}
    .ic.x{color:#c2c9d8}
    .ic.check{color:var(--purple)}

    .final{text-align:center;margin-top:96px}
    .final h2{font-size:clamp(24px,3vw,32px);font-weight:500;color:var(--navy);margin:0 0 12px;letter-spacing:-.4px}
    .final p{font-size:16px;color:var(--muted);max-width:460px;margin:0 auto 26px;line-height:1.5}

    @media (max-width:820px){
      .step,.step.flip{flex-direction:column;text-align:center;gap:30px}
      .step-text{max-width:520px}
      .step-num{margin-left:auto;margin-right:auto}
      .compare{grid-template-columns:1fr;margin-top:64px}
      .col li,.col.old li{text-align:left}
    }
  </style>
</BaseLayout>
