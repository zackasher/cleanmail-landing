---
import { pageTitle } from "../page-title";
import LegalLayout from "../layouts/LegalLayout.astro";
import { compiledContent } from "../content/legal/terms-of-service.md";
import { CURRENT_TERMS_NOTICE, TERMS_ARCHIVE } from "../config";

const newestArchive = TERMS_ARCHIVE["2026-10-26"];
const oldestArchive = TERMS_ARCHIVE["2026-10-09"];

// The Terms file is synced from the app repo, so the notice is placed after its first paragraph (the "Last updated" line) here rather than written into the file.
const termsHtml = await compiledContent();
const dateLineEnd = termsHtml.indexOf("</p>") + "</p>".length;
const termsBeforeNotice = termsHtml.slice(0, dateLineEnd);
const termsAfterNotice = termsHtml.slice(dateLineEnd);
---

<LegalLayout title={pageTitle("Terms of Service")} description="The terms of service for Cleanmail: Family Inbox on iPhone, Android and the web, including subscriptions, the free trial and your household.">
  <Fragment set:html={termsBeforeNotice} />
  <p class="terms-version-notice">{CURRENT_TERMS_NOTICE} {newestArchive.label} (<a href={newestArchive.path}>{newestArchive.path}</a>) and {oldestArchive.label} (<a href={oldestArchive.path}>{oldestArchive.path}</a>).</p>
  <Fragment set:html={termsAfterNotice} />
</LegalLayout>

<style>
  .terms-version-notice{padding:12px 16px;border:1px solid var(--line);border-radius:12px;background:#f7f9ff}
</style>
