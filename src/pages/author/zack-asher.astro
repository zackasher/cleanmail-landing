---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PressFeature from "../../components/PressFeature.astro";
import FounderArticles from "../../components/FounderArticles.astro";
import { ABOUT_BIO, ABOUT_DESCRIPTION, AUTHOR_ARTICLES_HEADING, AUTHOR_PAGE_TITLE } from "../../data/about-copy";
import { FOUNDER_PERSON } from "../../data/founder-schema";
import { FOUNDER_NAME, SCHEMA_PAGE_TYPE_NONE } from "../../config";
import "../../styles/info-page.css";

const profileSchema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "mainEntity": FOUNDER_PERSON,
};
---
<BaseLayout schemaPageType={SCHEMA_PAGE_TYPE_NONE} title={AUTHOR_PAGE_TITLE} description={ABOUT_DESCRIPTION}>
  <script type="application/ld+json" set:html={JSON.stringify(profileSchema)} />
  <section class="ip">
    <h1>{FOUNDER_NAME}</h1>
    <p class="ip-lede">{ABOUT_BIO}</p>
  </section>
  <PressFeature />
  <FounderArticles heading={AUTHOR_ARTICLES_HEADING} />
</BaseLayout>
