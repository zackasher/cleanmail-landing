---
import { pageTitle } from "../../page-title";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CTA from "../../components/CTA.astro";
import PhoneFrame from "../../components/PhoneFrame.astro";
import { ICON_PATHS } from "../../data-icons";
import { PRICE_MONTHLY, TRIAL_DAYS, TRIAL_RENEWAL_LINE, HOUSEHOLD_SIZE, SWITCHING_FACTS_CHECKED_ON } from "../../config";
import { SWITCHING_PAGES, SWITCHING_TRADEMARK_LINE, SWITCHING_OPENER_TAIL, type SwitchingPage } from "../../data/switching-from";
import "../../styles/info-page.css";

export function getStaticPaths() {
  return SWITCHING_PAGES.map((page) => ({ params: { app: page.slug }, props: { page } }));
}

const { page } = Astro.props as { page: SwitchingPage };

// Monthly only until the yearly price change lands (Marketing, 11/18).
const trialLine = `${TRIAL_DAYS} days free, then ${PRICE_MONTHLY} a month. ${TRIAL_RENEWAL_LINE}`;

const steps = [
  { icon: ICON_PATHS.email, tone: "", title: "Sign in with Google", body: "Use the Gmail your school and activities email." },
  { icon: ICON_PATHS.inboxes, tone: "teal", title: "Pick your senders", body: "School and activities, once." },
  { icon: ICON_PATHS.sync, tone: "orange", title: "Turn on Sync", body: "Your Google events show next to the school and activity dates." },
  { icon: ICON_PATHS.household, tone: "", title: "Invite your household", body: `Up to ${HOUSEHOLD_SIZE} people, you included.` },
];
const rowIcons = [ICON_PATHS.emailFast, ICON_PATHS.calendarCheck];
---
<BaseLayout
  title={pageTitle(`Switching from ${page.name}`)}
  description={`Switching from ${page.name}? ${page.lede}`}
  hideFooterAppLink={true}>
  <section class="ip">
    <div class="sw-hero">
      <div class="sw-hero-text">
        <p class="ip-eyebrow">Switching from {page.name}</p>
        <h1>{page.lede}</h1>
        <p class="ip-lede">{page.doesWell} {SWITCHING_OPENER_TAIL}</p>
        <CTA />
      </div>
      <div class="sw-hero-phone">
        <PhoneFrame>
          <img class="sw-shot" src={page.screenshot.src} width={page.screenshot.width} height={page.screenshot.height} alt={page.screenshot.alt} />
        </PhoneFrame>
      </div>
    </div>

    <div class="ip-section">
      <h2>Side by side</h2>
      <p class="ip-sub">As of {SWITCHING_FACTS_CHECKED_ON}.</p>
      <div class="sw-compare">
        <div class="sw-col-head"></div>
        <div class="sw-col-head cm">Cleanmail</div>
        <div class="sw-col-head">{page.name}</div>
        {page.rows.map((row, index) => (
          <>
            <div class="sw-row-label"><span class="ip-ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={rowIcons[index % rowIcons.length]} fill="currentColor" /></svg></span>{row.label}</div>
            <div class="sw-cell cm">{row.cleanmail}</div>
            <div class="sw-cell">{row.rival}</div>
          </>
        ))}
      </div>
    </div>

    <div class="ip-section">
      <h2>How to switch</h2>
      <div class="sw-steps">
        {steps.map((step, index) => (
          <div class="ip-tile num-step">
            <div class="num-step-top">
              <span class="sw-num">{index + 1}</span>
              <div class={`ip-ic ${step.tone}`}><svg viewBox="0 0 24 24" aria-hidden="true"><path d={step.icon} fill="currentColor" /></svg></div>
            </div>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </div>
        ))}
      </div>
      <p class="ip-sub sw-keep">{page.keepNote}</p>
    </div>

    <div class="ip-final">
      <h2>Try it free for {TRIAL_DAYS} days</h2>
      <p>{trialLine} No pressure: cancel anytime in your phone's settings.</p>
      <CTA />
    </div>

    <p class="sw-source">
      Sources, read {SWITCHING_FACTS_CHECKED_ON}:{" "}
      {page.sources.map((source, index) => (
        <>{index > 0 && " · "}<a href={source.url} rel="nofollow noopener" target="_blank">{source.label}</a></>
      ))}.
      {" "}{SWITCHING_TRADEMARK_LINE}
    </p>
  </section>

  <style>
    .sw-hero{display:grid;grid-template-columns:1.2fr 1fr;gap:32px;align-items:center;max-width:960px;margin:0 auto}
    .sw-hero-text .ip-lede{margin-bottom:28px}
    .sw-hero-phone{display:flex;justify-content:center}
    .sw-shot{width:100%;height:100%;object-fit:cover;object-position:top center;display:block}
    .sw-compare{display:grid;grid-template-columns:1.1fr 1fr 1fr;gap:10px;max-width:760px;margin:0 auto}
    .sw-col-head{font-weight:600;color:var(--navy);text-align:center;padding:6px 0;font-size:16px}
    .sw-col-head.cm{color:var(--purple)}
    .sw-row-label{display:flex;align-items:center;gap:10px;font-weight:600;color:var(--navy);font-size:15px}
    .sw-row-label .ip-ic{flex:0 0 40px;width:40px;height:40px}
    .sw-cell{background:#fff;border:1px solid var(--line);border-radius:14px;padding:14px;font-size:14.5px;line-height:1.45;color:var(--ink);text-align:center}
    .sw-cell.cm{border-color:rgba(74,111,227,.35);background:rgba(74,111,227,.05)}
    .sw-steps{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;max-width:960px;margin:0 auto}
    .sw-num{display:inline-flex;width:22px;height:22px;border-radius:50%;background:var(--purple);color:#fff;font-size:13px;align-items:center;justify-content:center;margin-right:4px;vertical-align:1px}
    .num-step{text-align:left}
    .num-step-top{display:flex;align-items:flex-start;justify-content:space-between}
    .num-step-top .sw-num{margin:0}
    .sw-keep{margin-top:16px}
    .sw-source{margin:40px auto 0;max-width:640px;text-align:center;font-size:13px;color:var(--muted)}
    .sw-source a{color:var(--muted)}
    @media (max-width:760px){
      .sw-hero{grid-template-columns:1fr;text-align:center}
      .sw-compare{grid-template-columns:1fr 1fr}
      .sw-compare .sw-col-head:first-child{display:none}
      .sw-row-label{grid-column:1 / -1;justify-content:center;margin-top:8px}
      .sw-steps{grid-template-columns:1fr 1fr}
    }
  </style>
</BaseLayout>
