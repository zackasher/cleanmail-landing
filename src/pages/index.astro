---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import PhoneFrame from "../components/PhoneFrame.astro";
import Reviews from "../components/Reviews.astro";
import TrustDeal from "../components/TrustDeal.astro";
import { ICON_PATHS } from "../data-icons";

const explore = [
  { href: "/compare", icon: ICON_PATHS.compare, color: "var(--purple)", title: "Cleanmail vs Skylight vs Cozi", body: "See how we stack up, side by side." },
  { href: "/google-calendar-sync", icon: ICON_PATHS.sync, color: "var(--orange)", title: "Two-way Google Calendar sync", body: "Edit anywhere, it changes everywhere." },
  { href: "/family-calendar-app", icon: ICON_PATHS.calendarHeart, color: "var(--teal)", title: "The family calendar that writes itself", body: "Every feature and the price, at a glance." },
];
---
<BaseLayout title="Cleanmail: Family Inbox | School Email Digest and Family Calendar">
  <Hero />

  <section class="film">
    <div class="film-wrap">
      <video class="hero-video film-video" autoplay muted playsinline preload="auto" poster="/hero-film-poster.jpg">
        <source src="/hero-film.webm" type="video/webm" />
        <source src="/hero-film.mp4" type="video/mp4" />
      </video>
      <button class="film-sound" type="button" aria-label="Unmute video" aria-pressed="false">
        <svg class="off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5L6.5 9H3v6h3.5L11 19V5z"/><path d="M16.5 9.5l5 5M21.5 9.5l-5 5"/></svg>
        <svg class="on" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11 5L6.5 9H3v6h3.5L11 19V5z"/><path d="M15.5 8.8a4.5 4.5 0 010 6.4M18.3 6a8.5 8.5 0 010 12"/></svg>
      </button>
    </div>
  </section>

  <Reviews />

  <section class="explore" aria-label="Explore Cleanmail">
    {explore.map((item) => (
      <a class="explore-card" href={item.href}>
        <span class="explore-ic"><svg viewBox="0 0 24 24" aria-hidden="true" style={`color:${item.color}`}><path d={item.icon} fill="currentColor" /></svg></span>
        <span class="explore-text"><span class="explore-title">{item.title}</span><span class="explore-body">{item.body}</span></span>
        <span class="explore-arrow" aria-hidden="true">›</span>
      </a>
    ))}
  </section>

  <section class="story" id="how">
     <hr class="story-rule" />
    <div class="story-grid">
      <div class="story-visual">
        <PhoneFrame>
          <video class="hero-video" autoplay muted loop playsinline preload="metadata" poster="/hero-poster.jpg">
            <source src="/hero.mp4" type="video/mp4" />
          </video>
        </PhoneFrame>
      </div>

      <div class="story-text">
        <div class="story-bubble">
          <p class="story-eyebrow">From the founder</p>
          <p class="story-lead">Hi. I'm Zack, and I kept missing things.</p>
          <p class="story-copy">I'm a dad of two, and for a long time I was juggling three calendars and pages-long emails from nine different schools and apps. I still kept missing things that mattered to my kids.</p>
          <p class="story-copy">So one night I'd had enough. I wrote a quick script that turned all that email into one simple digest I could actually read, and dropped every date straight onto my calendar.</p>
          <p class="story-copy">Then the craziest thing happened. I became the expert on my own family's schedule. Every event, every appointment, a brief of my kids' days I could read in seconds instead of hours.</p>
          <p class="story-copy">Every parent I showed asked the same thing: which app is that? So I built the one they already thought it was. Now my email notifications are off, and I just swipe through Cleanmail every day.</p>
          <p class="story-sig">Zack, founder of Cleanmail</p>
        </div>
      </div>
    </div>
     <hr class="story-rule" />
  </section>

  <TrustDeal />
</BaseLayout>

<script>
  function initFilmSound(){
    const video = document.querySelector(".film-video");
    const button = document.querySelector(".film-sound");
    if (!video || !button || button.dataset.bound) return;
    button.dataset.bound = "1";
    button.addEventListener("click", () => {
      video.muted = !video.muted;
      const unmuted = !video.muted;
      button.classList.toggle("unmuted", unmuted);
      button.setAttribute("aria-label", unmuted ? "Mute video" : "Unmute video");
      button.setAttribute("aria-pressed", String(unmuted));
      if (unmuted && video.paused) {
        const played = video.play();
        if (played && played.catch) played.catch(() => {});
      }
    });
  }
  document.addEventListener("astro:page-load", initFilmSound);
  if (document.readyState !== "loading") initFilmSound();
</script>

<style>
  .film{max-width:1010px;margin:0 auto 8px;padding:0 24px}
  .film-wrap{position:relative;line-height:0}
  .film-video{width:100%;height:auto;display:block;border-radius:20px;border:1px solid var(--line);box-shadow:0 18px 44px rgba(27,34,54,.12);background:#eef2fb}
  .film-sound{position:absolute;right:16px;bottom:16px;width:42px;height:42px;border-radius:50%;border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;color:#fff;background:rgba(27,34,54,.5);-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);transition:background .15s ease}
  .film-sound:hover{background:rgba(27,34,54,.72)}
  .film-sound svg{width:20px;height:20px}
  .film-sound .on{display:none}
  .film-sound.unmuted .off{display:none}
  .film-sound.unmuted .on{display:block}
  .story{padding: 0px 24px 40px}
  .story-grid{max-width:1010px;margin:0 auto;display:flex;align-items:flex-start;justify-content:center;gap:48px}
  .story-visual{flex:0 0 auto}
  .story-text{flex:1 1 0;max-width:530px}
  .story-bubble{background:var(--card);border:1px solid var(--line);border-radius:18px;padding:30px 34px}
  .story-eyebrow{font-size:11px;font-weight:500;color:var(--orange);text-transform:uppercase;letter-spacing:.6px;margin-bottom:14px}
  .story-lead{font-size:20px;font-weight:500;line-height:1.35;color:var(--navy);margin-bottom:20px}
  .story-copy{font-size:16px;line-height:1.62;color:var(--ink);margin-bottom:20px}
  .story-sig{margin-top:6px;font-size:14px;font-weight:500;color:var(--muted)}
  .hero-video{width:100%;height:100%;object-fit:cover;display:block}
  .story-rule{height:1px;border:0;width:calc(100% - 48px);max-width:860px;margin:24px auto;background:linear-gradient(90deg, transparent, rgba(74,111,227,.5) 22%, rgba(74,111,227,.5) 78%, transparent)}
  .story-rule:first-of-type{margin-bottom:56px}
  .story-rule:last-of-type{margin-top:56px}
  @media(max-width:800px){
    .story-grid{flex-direction:column;align-items:center;gap:30px}
    .story-text{max-width:530px;width:100%}
  }
  .explore{max-width:1000px;margin:40px auto 10px;padding:0 24px;display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
  .explore-card{display:flex;align-items:center;gap:14px;background:#fff;border:1.5px solid rgba(74,111,227,.35);border-radius:18px;padding:16px 16px;text-decoration:none;box-shadow:0 8px 22px rgba(27,34,54,.05);transition:transform .15s ease,box-shadow .15s ease}
  .explore-card:hover{transform:translateY(-2px);box-shadow:0 12px 28px rgba(74,111,227,.15)}
  .explore-ic{flex:0 0 44px;height:44px;border-radius:12px;background:#f3f5fb;display:flex;align-items:center;justify-content:center}
  .explore-ic svg{width:24px;height:24px}
  .explore-text{flex:1;display:flex;flex-direction:column;gap:3px}
  .explore-title{font-size:15.5px;font-weight:600;color:var(--navy);line-height:1.25}
  .explore-body{font-size:13.5px;color:var(--muted);line-height:1.35}
  .explore-arrow{font-size:26px;color:var(--purple);line-height:1}
  @media (max-width:820px){ .explore{grid-template-columns:1fr} }
</style>
