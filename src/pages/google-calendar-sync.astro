---
import BaseLayout from "../layouts/BaseLayout.astro";
import CTA from "../components/CTA.astro";
import Mark from "../components/Mark.astro";
import SyncDiagram from "../components/SyncDiagram.astro";
import { ICON_PATHS } from "../data-icons";
import "../styles/info-page.css";

const synced = ["Title", "Date", "Time", "Location", "Deletes", "Restores"];

const chart = [
  { icon: ICON_PATHS.pencil, color: "var(--purple)", before: "Fix it in two places", after: "Edit once, it changes everywhere" },
  { icon: ICON_PATHS.delete, color: "var(--orange)", before: "Deleted events come back", after: "Delete in Google, it stays deleted" },
  { icon: ICON_PATHS.restore, color: "var(--teal)", before: "A wrong delete is gone", after: "Restore it from either place" },
  { icon: ICON_PATHS.calendarCheck, color: "var(--purple)", before: "Retype events into your calendar", after: "Lands on the calendar you pick" },
  { icon: ICON_PATHS.calendarImport, color: "var(--orange)", before: "Google events stuck in Google", after: "Google events show up in Cleanmail" },
  { icon: ICON_PATHS.cellphone, color: "var(--teal)", before: "iPhone Calendar edits get lost", after: "Edit from your iPhone Calendar too" },
];

const faqs = [
  { q: "Does Cleanmail have two-way Google Calendar sync?", a: "Yes. Cleanmail has dedicated two-way Google Calendar sync. It puts the dates from your school and activity email on your Google Calendar, and when you edit or delete one of those events in Google Calendar, the change comes back to Cleanmail automatically, usually within seconds." },
  { q: "What happens if I delete an event in Google Calendar?", a: "It leaves Cleanmail too and goes to Cleanmail's Trash, labeled Deleted in Google Calendar. A later email from the school won't put it back on your calendar. If you change your mind, restore it in either Google Calendar or Cleanmail and it comes back in both." },
  { q: "If an event is edited in both places, which one wins?", a: "The most recent edit wins. Cleanmail never wins just because it's Cleanmail." },
  { q: "Which changes sync back from Google Calendar?", a: "Title, date, time, and location, plus deletes and restores. Edits made in the iPhone Calendar app sync back too when it's showing your Google calendar." },
  { q: "Which calendar does Cleanmail write to?", a: "The one you pick, called your main calendar. You choose it during setup and can switch it anytime in Settings. Events you create yourself in Google Calendar show up inside Cleanmail too, labeled Google Calendar." },
  { q: "Can Cleanmail delete my calendars?", a: "No. Cleanmail only asks Google for permission to add and edit events. It never asks to delete or manage your calendars, and you can see the exact permission on Google's consent screen when you connect." },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((item) => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": { "@type": "Answer", "text": item.a },
  })),
};
---
<BaseLayout
  title="Dedicated Two-Way Google Calendar Sync | Cleanmail"
  description="Cleanmail's dedicated two-way Google Calendar sync: dates from school email go to Google Calendar, and your edits and deletes in Google come back to Cleanmail automatically."
  faqSchema={faqSchema}
>
  <section class="ip">
    <p class="ip-eyebrow">Google Calendar sync</p>
    <h1 class="one-line">Dedicated two-way Google Calendar sync.</h1>
    <p class="ip-lede lede-lines"><span>Every date from your school email lands on your Google Calendar.</span><span>Change it there, and Cleanmail changes too.</span></p>


    <div class="ip-section">
      <h2>What it means for you</h2>
      <p class="ip-sub">One family schedule, wherever you touch it.</p>
      <div class="compare-cards">
        <div class="cm-card">
          <div class="cm-head without">Without it</div>
          {chart.map((row) => <div class="cm-row muted"><Mark kind="no" />{row.before}</div>)}
        </div>
        <div class="cm-card with">
          <div class="cm-head with">With Cleanmail</div>
          {chart.map((row) => (
            <div class="cm-row"><svg class="chart-icon" viewBox="0 0 24 24" aria-hidden="true" style={`color:${row.color}`}><path d={row.icon} fill="currentColor" /></svg><Mark kind="yes" />{row.after}</div>
          ))}
        </div>
      </div>
    </div>

    <div class="ip-section">
      <h2>What syncs back from Google</h2>
      <p class="ip-sub">Edit a Cleanmail event in Google Calendar and these follow it home.</p>
      <SyncDiagram />
      <div class="ip-chips">
        {synced.map((item) => <span class="ip-chip yes"><Mark kind="yes" />{item}</span>)}
      </div>
    </div>



    <div class="ip-section">
      <h2>Quick answers</h2>
      <div class="ip-faq">
        {faqs.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
      <div class="ip-links">
        <a href="/family-calendar-app">Everything in the app</a>
      </div>
    </div>

    <div class="ip-final">
      <h2>Let your calendar keep itself</h2>
      <p>Connect Gmail and Google Calendar once, and the dates take care of themselves.</p>
      <CTA />
    </div>
  </section>

  <style>

    .chart-icon{width:24px;height:24px;flex-shrink:0}
    .one-line{max-width:none}
    .lede-lines span{display:block}
    .compare-cards{display:grid;grid-template-columns:350fr 406fr;gap:0;max-width:756px;margin:0 auto;filter:drop-shadow(0 8px 18px rgba(27,34,54,.06))}
    .cm-card{background:#fff;border:2px solid var(--orange);border-radius:18px;overflow:hidden;box-shadow:0 8px 22px rgba(27,34,54,.05)}
    .cm-card{box-shadow:none}
    .cm-card:not(.with){border-right:0;border-radius:18px 0 0 18px}
    .cm-card.with{border-color:var(--purple);border-left:0;border-radius:0 18px 18px 0}
    .cm-head{padding:12px 18px;font-size:13.5px;font-weight:600;text-transform:uppercase;letter-spacing:1px}
    .cm-head.without{color:#fff;background:var(--orange)}
    .cm-head.with{color:#fff;background:var(--purple)}
    .cm-row{display:flex;align-items:center;gap:10px;min-height:52px;padding:10px 18px;white-space:nowrap;border-top:1px solid var(--line);font-size:15px;line-height:1.35;color:var(--navy)}
    .cm-row.muted{color:var(--muted);background:var(--card)}
    .cm-row.muted :global(.mark.no circle){fill:var(--orange)}
    .cm-row :global(.mark.yes circle){fill:var(--teal)}
    @media (max-width:640px){
      .compare-cards{grid-template-columns:1fr;gap:14px}
      .cm-card:not(.with){border-right:2px solid var(--orange);border-radius:18px}
      .cm-card.with{border-left:2px solid var(--purple);border-radius:18px}
      .cm-row{white-space:normal}
    }
  </style>
</BaseLayout>
