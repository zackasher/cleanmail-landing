---
import { pageTitle } from "../../page-title";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CTA from "../../components/CTA.astro";
import PhoneFrame from "../../components/PhoneFrame.astro";
import VoiceBars from "../../components/VoiceBars.astro";
import { PRICE_MONTHLY, TRIAL_DAYS, TRIAL_RENEWAL_LINE } from "../../config";
import { FEATURE_PAGES, type FeaturePage } from "../../data/feature-pages";
import "../../styles/info-page.css";

export function getStaticPaths() {
  return FEATURE_PAGES.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

const { page } = Astro.props as { page: FeaturePage };

// Monthly only until the yearly price change lands (Marketing, 11/18).
const trialLine = `${TRIAL_DAYS} days free, then ${PRICE_MONTHLY} a month. ${TRIAL_RENEWAL_LINE}`;
---
<BaseLayout title={pageTitle(page.title)} description={`${page.headline} ${page.lede}`} hideFooterAppLink={true}>
  <section class="ip">
    <div class="sw-hero">
      <div class="sw-hero-text">
        <p class="ip-eyebrow">{page.eyebrow}</p>
        <h1>{page.headline}</h1>
        <p class="ip-lede">{page.lede}</p>
        {page.afterLede && <p class="ft-after-lede">{page.afterLede}</p>}
        <CTA />
      </div>
      <div class="sw-hero-phone">
        <PhoneFrame>
          <div class="ft-shot" style={`aspect-ratio:${page.screenshot.width} / ${page.screenshot.height}`}>
            <img class="sw-shot" src={page.screenshot.src} width={page.screenshot.width} height={page.screenshot.height} alt={page.screenshot.alt} />
            {page.screenshot.waveform && <VoiceBars />}
          </div>
        </PhoneFrame>
      </div>
    </div>

    <div class="ip-section">
      <div class="ft-grid">
        {page.tiles.map((tile) => (
          <div class="ip-tile center">
            <div class={`ip-ic ${tile.tone}`}><svg viewBox="0 0 24 24" aria-hidden="true"><path d={tile.icon} fill="currentColor" /></svg></div>
            <h3>{tile.title}</h3>
            <p>{tile.body}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="ip-section">
      <h2>How it works</h2>
      <div class="ft-steps">
        {page.steps.map((step, index) => (
          <div class="ip-tile num-step">
            <div class="num-step-top"><span class="sw-num">{index + 1}</span></div>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="ip-final">
      <h2>Try it free for {TRIAL_DAYS} days</h2>
      <p>{trialLine} No pressure: cancel anytime in your phone's settings.</p>
      <CTA />
    </div>

    {page.footnote && <p class="ft-footnote">{page.footnote}</p>}
  </section>

<style>
    .sw-hero{display:grid;grid-template-columns:1.2fr 1fr;gap:32px;align-items:center;max-width:960px;margin:0 auto}
    .sw-hero-text .ip-lede{margin-bottom:28px}
    .sw-hero-phone{display:flex;justify-content:center}
    .ft-shot{position:relative;width:100%}
    .sw-shot{width:100%;height:100%;object-fit:cover;object-position:top center;display:block}
    .ft-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;max-width:960px;margin:0 auto}
    .ft-steps{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;max-width:760px;margin:0 auto}
    .num-step{text-align:left;padding:28px 26px 22px 22px}
    .num-step-top{display:flex;align-items:center;justify-content:space-between}
    .num-step-top .sw-num{margin:0;width:36px;height:36px;border-radius:10px;font-size:16px;font-weight:600}
    .sw-num{display:inline-flex;width:22px;height:22px;border-radius:50%;background:var(--purple);color:#fff;font-size:13px;align-items:center;justify-content:center;margin-right:4px;vertical-align:1px}
    .ft-after-lede{max-width:600px;margin:-14px auto 28px;text-align:center;font-size:15px;font-weight:500;color:var(--purple)}
    .ft-footnote{margin:40px auto 0;max-width:640px;text-align:center;font-size:13px;color:var(--muted)}
    @media (max-width:760px){
      .sw-hero{grid-template-columns:1fr;text-align:center}
      .ft-grid{grid-template-columns:1fr 1fr}
      .ft-steps{grid-template-columns:1fr}
    }
  </style>
</BaseLayout>
